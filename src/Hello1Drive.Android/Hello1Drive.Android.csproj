<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Hello1Drive.Android</RootNamespace>
    <AssemblyName>Hello1Drive.Android</AssemblyName>
    <ApplicationId>com.xiaowei.hello1drive</ApplicationId>
    <ApplicationTitle>Hello1Drive</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <AndroidPackageFormats>apk;aab</AndroidPackageFormats>
  </PropertyGroup>


  <!--
    Keep Debug builds self-contained on-device.
    Clearing Android app data deletes the Fast Deployment __override__ assemblies.
    With EmbedAssembliesIntoApk=true the managed assemblies stay inside the APK,
    so "Clear all data" cannot make the next cold start abort before managed code runs.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Hello1Drive.Core/Hello1Drive.Core.csproj" />
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Xamarin.AndroidX.Browser" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" />
    <PackageReference Include="Xamarin.AndroidX.RecyclerView" />
    <PackageReference Include="Xamarin.AndroidX.SwipeRefreshLayout" />
  </ItemGroup>
</Project>
