            <Grid IsVisible="{Binding HasNoThumbnailImage}">
              <Viewbox
                Width="116"
                Height="116"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsFolder}"
                Stretch="Uniform">
                <Canvas Width="32" Height="26">
                  <!--  Layered yellow folder matched to the supplied OneDrive folder artwork.  -->
                  <Path Data="M0,7.5 C0,5.1 1.9,3.1 4.3,3.1 H9.7 C10.7,3.1 11.4,3.4 12.2,4 L15.2,6.3 C16.2,7.1 17.3,7.4 18.7,7.4 H29.5 C30.9,7.4 32,8.5 32,9.9 V22.3 C32,24.3 30.3,26 28.3,26 H3.7 C1.7,26 0,24.3 0,22.3 Z" Fill="#F7BC0F" />
                  <Border
                    Canvas.Left="4.4"
                    Canvas.Top="8.8"
                    Width="24.5"
                    Height="12.6"
                    Background="#FFD28D"
                    CornerRadius="1.2" />
                  <Border
                    Canvas.Left="3.2"
                    Canvas.Top="10.1"
                    Width="24.5"
                    Height="11.8"
                    Background="#FFF2D6"
                    CornerRadius="1.2" />
                  <Border
                    Canvas.Left="0"
                    Canvas.Top="11.5"
                    Width="32"
                    Height="14.5"
                    Background="#FFD76B"
                    CornerRadius="2.1" />
                  <Border
                    Canvas.Left="2"
                    Canvas.Top="12.2"
                    Width="28"
                    Height="1.2"
                    Background="#55FFE9B0"
                    CornerRadius="0.6" />
                </Canvas>
              </Viewbox>
              <Grid
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsAudio}">
                <Viewbox
                  Width="116"
                  Height="116"
                  Stretch="Uniform">
                  <Canvas Width="32" Height="32">
                    <Ellipse
                      Canvas.Left="2"
                      Canvas.Top="7"
                      Width="23"
                      Height="23"
                      Fill="#60A5FA"
                      Opacity="0.95" />
                    <Ellipse
                      Canvas.Left="7"
                      Canvas.Top="2"
                      Width="23"
                      Height="23"
                      Fill="#FB7185"
                      Opacity="0.94" />
                    <Path
                      Data="M13,9 V22 M13,9 L23,6.8 V18.5"
                      Fill="Transparent"
                      Stroke="White"
                      StrokeJoin="Round"
                      StrokeLineCap="Round"
                      StrokeThickness="2.2" />
                    <Ellipse
                      Canvas.Left="6.2"
                      Canvas.Top="19.3"
                      Width="7.4"
                      Height="5.8"
                      Fill="White" />
                    <Ellipse
                      Canvas.Left="16.2"
                      Canvas.Top="15.8"
                      Width="7.4"
                      Height="5.8"
                      Fill="White" />
                  </Canvas>
                </Viewbox>
              </Grid>
              <Grid
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsImage}">
                <Viewbox
                  Width="116"
                  Height="116"
                  Stretch="Uniform">
                  <Canvas Width="32" Height="32">
                    <Border
                      Canvas.Left="2"
                      Canvas.Top="2"
                      Width="28"
                      Height="28"
                      Background="#EEF7FF"
                      BorderBrush="#8EC5FF"
                      BorderThickness="1.2"
                      CornerRadius="7" />
                    <Path
                      Data="M7,23 L12,16.5 L16,20 L20,15.5 L25,23"
                      Fill="Transparent"
                      Stroke="#3B82F6"
                      StrokeJoin="Round"
                      StrokeLineCap="Round"
                      StrokeThickness="1.8" />
                    <Ellipse
                      Canvas.Left="8"
                      Canvas.Top="8"
                      Width="5"
                      Height="5"
                      Fill="#FDBA74" />
                  </Canvas>
                </Viewbox>
              </Grid>
              <Grid IsVisible="{Binding IsVideo}">
                <Border
                  Width="126"
                  Height="126"
                  Background="#EEF2FF"
                  BorderBrush="#A5B4FC"
                  BorderThickness="2"
                  CornerRadius="18" />
                <Border
                  Width="58"
                  Height="58"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="#7C3AED"
                  CornerRadius="29">
                  <TextBlock
                    Margin="5,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="30"
                    Foreground="White"
                    Text="▶" />
                </Border>
              </Grid>
              <Grid IsVisible="{Binding IsPdf}">
                <Border
                  Width="112"
                  Height="132"
                  Background="#FFF5F5"
                  BorderBrush="#F0A0A8"
                  BorderThickness="2"
                  CornerRadius="16" />
                <Border
                  Width="112"
                  Height="30"
                  VerticalAlignment="Bottom"
                  Background="#EF4444"
                  CornerRadius="0,0,16,16" />
                <TextBlock
                  Margin="0,0,0,8"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="White"
                  Text="PDF" />
              </Grid>
              <Grid IsVisible="{Binding IsWord}">
                <Border
                  Width="112"
                  Height="132"
                  Background="#EFF6FF"
                  BorderBrush="#93C5FD"
                  BorderThickness="2"
                  CornerRadius="16" />
                <Border
                  Width="112"
                  Height="30"
                  VerticalAlignment="Bottom"
                  Background="#2563EB"
                  CornerRadius="0,0,16,16" />
                <TextBlock
                  Margin="0,0,0,8"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="White"
                  Text="DOC" />
              </Grid>
              <Grid IsVisible="{Binding IsExcel}">
                <Border
                  Width="112"
                  Height="132"
                  Background="#F0FDF4"
                  BorderBrush="#86EFAC"
                  BorderThickness="2"
                  CornerRadius="16" />
                <Border
                  Width="112"
                  Height="30"
                  VerticalAlignment="Bottom"
                  Background="#16A34A"
                  CornerRadius="0,0,16,16" />
                <TextBlock
                  Margin="0,0,0,8"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="White"
                  Text="XLS" />
              </Grid>
              <Grid IsVisible="{Binding IsPowerPoint}">
                <Border
                  Width="112"
                  Height="132"
                  Background="#FFF7ED"
                  BorderBrush="#FDBA74"
                  BorderThickness="2"
                  CornerRadius="16" />
                <Border
                  Width="112"
                  Height="30"
                  VerticalAlignment="Bottom"
                  Background="#F97316"
                  CornerRadius="0,0,16,16" />
                <TextBlock
                  Margin="0,0,0,8"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="White"
                  Text="PPT" />
              </Grid>
              <Grid IsVisible="{Binding IsArchive}">
                <Border
                  Width="112"
                  Height="132"
                  Background="#F5F3FF"
                  BorderBrush="#C4B5FD"
                  BorderThickness="2"
                  CornerRadius="16" />
                <Border
                  Width="112"
                  Height="30"
                  VerticalAlignment="Bottom"
                  Background="#8B5CF6"
                  CornerRadius="0,0,16,16" />
                <TextBlock
                  Margin="0,0,0,8"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="White"
                  Text="ZIP" />
              </Grid>
              <Grid IsVisible="{Binding IsUrlShortcut}">
                <Border
                  Width="112"
                  Height="132"
                  Background="#F0FDFA"
                  BorderBrush="#5EEAD4"
                  BorderThickness="2"
                  CornerRadius="16" />
                <Border
                  Width="112"
                  Height="30"
                  VerticalAlignment="Bottom"
                  Background="#0EA5A4"
                  CornerRadius="0,0,16,16" />
                <TextBlock
                  Margin="0,0,0,8"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="White"
                  Text="URL" />
              </Grid>
              <Grid IsVisible="{Binding IsText}">
                <Border
                  Width="112"
                  Height="132"
                  Background="#F8FAFC"
                  BorderBrush="#CBD5E1"
                  BorderThickness="2"
                  CornerRadius="16" />
                <Border
                  Width="112"
                  Height="30"
                  VerticalAlignment="Bottom"
                  Background="#64748B"
                  CornerRadius="0,0,16,16" />
                <TextBlock
                  Margin="0,0,0,8"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="White"
                  Text="TXT" />
              </Grid>
              <Grid IsVisible="{Binding IsGenericFile}">
                <Border
                  Width="112"
                  Height="132"
                  Background="#F8FAFC"
                  BorderBrush="#C7D2E4"
                  BorderThickness="2"
                  CornerRadius="16" />
                <Border
                  Width="112"
                  Height="30"
                  VerticalAlignment="Bottom"
                  Background="#60A5FA"
                  CornerRadius="0,0,16,16" />
                <TextBlock
                  Margin="0,0,0,8"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="White"
                  Text="{Binding FileBadgeText}" />
              </Grid>
            </Grid>
            <Border
              Background="#16000000"
              ClipToBounds="True"
              CornerRadius="10"
              IsVisible="{Binding HasThumbnailImage}">
              <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" />
            </Border>
            <Border
              Width="30"
              Height="30"
              Margin="0,0,7,7"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Background="#B0000000"
              CornerRadius="15"
              IsVisible="{Binding ShowVideoThumbnailBadge}">
              <TextBlock
                Margin="2,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="White"
                Text="▶" />
            </Border>
          </Grid>
          <TextBlock
            Grid.Row="1"
            FontSize="15"
            MaxLines="2"
            Text="{Binding Name}"
            TextAlignment="Center"
            TextTrimming="CharacterEllipsis" />
          <TextBlock
            Grid.Row="2"
            HorizontalAlignment="Center"
            Classes="caption"
            Text="{Binding SizeDisplay}" />
        </Grid>
      </Border>
    </DataTemplate>

    <!--
      Desktop uses the same fixed logical slots as mobile. The actual desktop file template is
      hosted only after metadata for that index exists; unloaded tail slots keep the scroll extent
      stable without creating a full DriveItemModel or thumbnail object.
    -->
  </UserControl.Resources>

  <Grid x:Name="RootGrid" ClipToBounds="True">
    <!--  Customizable window background  -->
    <Border x:Name="BackgroundColorLayer" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    <Image
      x:Name="BackgroundImageLayer"
      IsVisible="False"
      Stretch="UniformToFill" />
    <Border
      x:Name="BackgroundScrimLayer"
      Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
      Opacity="0.30" />

    <!--  Cross-platform startup splash.  -->
    <Grid
      x:Name="StartupSplashOverlay"
      Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
      IsHitTestVisible="True"
      Opacity="1"
      ZIndex="5000">
      <Grid.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:00:00.160" />
        </Transitions>
      </Grid.Transitions>
      <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="14">
        <Image
          Width="112"
          Height="112"
          HorizontalAlignment="Center"
          Source="/Assets/app-icon.png" />
        <TextBlock
          HorizontalAlignment="Center"
          FontSize="30"
          FontWeight="SemiBold"
          Text="Hello1Drive" />
        <controls:LoadingIndicator Margin="0,8,0,0" />
      </StackPanel>
    </Grid>

    <!--  Login  -->
    <Grid IsVisible="{Binding IsNotAuthenticated}">
      <Border
        MaxWidth="440"
        Margin="24"
        Padding="{OnFormFactor Desktop='34',
                               Mobile='24'}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
        BorderThickness="1"
        BoxShadow="0 12 38 0 #35000000"
        CornerRadius="18">
        <StackPanel Spacing="16">
          <Image
            Width="92"
            Height="92"
            HorizontalAlignment="Center"
            Source="/Assets/app-icon.png" />
          <TextBlock
            HorizontalAlignment="Center"
            FontSize="32"
            FontWeight="SemiBold"
            Text="Hello1Drive" />
          <TextBlock
            Opacity="0.65"
            Text="全平台 OneDrive 客户端"
            TextAlignment="Center" />
          <Button
            MinHeight="48"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Classes="coral"
            Command="{Binding LoginCommand}"
            Content="登录 Microsoft 账户"
            FontSize="15" />
          <TextBlock
            Classes="caption"
            Text="权限：User.Read + Files.ReadWrite"
            TextAlignment="Center" />
          <TextBlock
            Classes="caption"
            Text="{Binding StatusText}"
            TextAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <!--  Main file manager  -->
    <Grid IsVisible="{Binding IsAuthenticated}" RowDefinitions="Auto,Auto,*,Auto">
      <!--  Desktop first-row toolbar is hosted by MainWindow inside the custom title bar.  -->

      <!--  Mobile toolbar  -->
      <Border
        x:Name="MobileTopToolbar"
        Grid.Row="0"
        MinHeight="0"
        Padding="5,2"
        Background="Transparent"
        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
        BorderThickness="0,0,0,1"
        ClipToBounds="True"
        IsVisible="{OnFormFactor Desktop=False,
                                 Mobile=True}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
            <ScrollViewer
              x:Name="MobileBreadcrumbScrollViewer"
              Grid.Column="0"
              Margin="2,0,4,0"
              VerticalAlignment="Center"
              HorizontalScrollBarVisibility="Hidden"
              VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="1" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:BreadcrumbItem">
                    <StackPanel Orientation="Horizontal" Spacing="1">
                      <Button
                        Padding="5,2"
                        Classes="breadcrumb"
                        Click="BreadcrumbButton_Click"
                        Content="{Binding Name}" />
                      <TextBlock
                        VerticalAlignment="Center"
                        Opacity="0.42"
                        Text="›" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Button
              Grid.Column="1"
              Classes="titleToolbar"
              Command="{Binding ToggleTransfersCommand}"
              ToolTip.Tip="上传 / 下载列表">
              <Grid Width="24" Height="24">
                <!--  Transfer icon: simple, immediately recognizable up/down pair.  -->
                <Path
                  Width="9"
                  Height="15"
                  Margin="2,0,0,0"
                  HorizontalAlignment="Left"
                  Classes="toolbarIcon iconTransferUp"
                  Data="M4.5,13 V2.5 M1.8,5.2 L4.5,2.5 L7.2,5.2" />
                <Path
                  Width="9"
                  Height="15"
                  Margin="0,0,2,0"
                  HorizontalAlignment="Right"
                  Classes="toolbarIcon iconTransferDown"
                  Data="M4.5,2 V12.5 M1.8,9.8 L4.5,12.5 L7.2,9.8" />
                <Border
                  Width="13"
                  Height="13"
                  Margin="0,-3,-4,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Background="{DynamicResource HelloAccentBrush}"
                  CornerRadius="7"
                  IsVisible="{Binding HasActiveTransfers}">
                  <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="8"
                    Foreground="White"
                    Text="{Binding ActiveTransferCount}" />
                </Border>
              </Grid>
            </Button>
            <Button
              Grid.Column="2"
              Width="30"
              Height="30"
              Padding="0"
              Click="MobileAvatarButton_Click"
              CornerRadius="15">
              <Grid Width="28" Height="28">
                <Border Background="{DynamicResource HelloAccentBrush}" CornerRadius="14">
                  <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{Binding UserInitial}" />
                </Border>
                <Border
                  ClipToBounds="True"
                  CornerRadius="14"
                  IsVisible="{Binding HasUserAvatar}">
                  <Image Source="{Binding UserAvatar}" Stretch="UniformToFill" />
                </Border>
              </Grid>
            </Button>
          </Grid>
          <TextBox
            Classes="search"
            PlaceholderText="搜索当前文件夹"
            Text="{Binding SearchText, Mode=TwoWay}" />
        </StackPanel>
      </Border>

      <!--  File action toolbar. Primary actions stay left-aligned in Home / Refresh / Download / New / Rename / Delete order.  -->
      <Border
        x:Name="FileActionToolbar"
        Grid.Row="1"
        MinHeight="{OnFormFactor Desktop=34,
                                 Mobile=0}"
        Padding="{OnFormFactor Desktop='6,0',
                               Mobile='5,2'}"
        Background="Transparent"
        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
        BorderThickness="0,0,0,1"
        ClipToBounds="{OnFormFactor Desktop=False,
                                    Mobile=True}"
        IsVisible="{Binding ShowToolbar}">
        <Grid
          VerticalAlignment="Stretch"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="10"
          RowDefinitions="{OnFormFactor Desktop='*,0',
                                        Mobile='Auto,Auto'}"
          RowSpacing="4">
          <!--  Left side of the toolbar: primary file actions in Explorer-like order.  -->
          <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,6,0,-1"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            IsVisible="{OnFormFactor Desktop=True,
                                     Mobile=False}"
            Orientation="Horizontal"
            Spacing="5">
            <Button
              Classes="toolbar"
              Command="{Binding GoRootCommand}"
              ToolTip.Tip="主页">
              <Path Classes="toolbarIcon iconHome" Data="M1.5,6.2 L7,1.8 L12.5,6.2 M3.5,5.1 V11.5 H10.5 V5.1" />
            </Button>
            <Button
              Classes="toolbar"
              Command="{Binding RefreshCommand}"
              ToolTip.Tip="刷新">
              <Path Classes="toolbarIcon iconRefresh" Data="M11.6,5 A5,5 0 1 0 11,9.5 M11.6,5 V2 M11.6,5 H8.6" />
            </Button>
            <Button
              Classes="toolbar"
              Click="DownloadButton_Click"
              IsEnabled="{Binding HasDownloadableSelection}"
              ToolTip.Tip="下载">
              <Path Classes="toolbarIcon iconDownload" Data="M7,1.5 V9 M4.5,6.5 L7,9 L9.5,6.5 M2,11.5 H12" />
            </Button>
            <Button
              Classes="toolbar"
              Command="{Binding BeginCreateFolderCommand}"
              ToolTip.Tip="新建文件夹">
              <Path Classes="toolbarIcon iconFolder opticalUp" Data="M1.5,3.5 H5 L6.5,5 H12.5 V11.5 H1.5 Z M9,6.7 V9.8 M7.45,8.25 H10.55" />
            </Button>
            <Button
              Classes="toolbar"
              Command="{Binding BeginRenameCommand}"
              IsEnabled="{Binding HasSingleSelection}"
              ToolTip.Tip="重命名">
              <Path Classes="toolbarIcon iconRename" Data="M2,11.5 L2.7,8.8 L9.7,1.8 L12.2,4.3 L5.2,11.3 Z M8.5,3 L11,5.5" />
            </Button>
            <Button
              Classes="toolbar"
              Command="{Binding BeginDeleteCommand}"
              IsEnabled="{Binding HasSelection}"
              ToolTip.Tip="删除">
              <Path Classes="toolbarIcon iconDanger" Data="M3,4 H11 M5,4 V2.5 H9 V4 M4,5.5 L4.6,12 H9.4 L10,5.5 M6,6.7 V10 M8,6.7 V10" />
            </Button>
          </StackPanel>

          <!--  View-mode controls stay on the right so the six primary actions remain grouped at the left.  -->
          <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,6,0,-1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            IsVisible="{OnFormFactor Desktop=True,
                                     Mobile=False}"
            Orientation="Horizontal"
            Spacing="5">
            <Button Classes="viewMode" ToolTip.Tip="查看方式">
              <Path Classes="toolbarIcon iconView opticalUp" Data="M1.5,2.4 H5.4 M1.5,7 H5.4 M1.5,11.6 H5.4 M8.4,2.4 H11.8 V5.8 H8.4 Z M8.4,8.2 H11.8 V11.6 H8.4 Z" />
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Click="ViewContextMenu_Click" Tag="Details">
                    <MenuItem.Header>
                      <TextBlock VerticalAlignment="Center" Text="详细信息" />
                    </MenuItem.Header>
                    <MenuItem.Icon>
                      <Grid
                        Width="26"
                        ColumnDefinitions="8,14"
                        ColumnSpacing="4">
                        <Ellipse
                          Width="6"
                          Height="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="{DynamicResource HelloAccentBrush}"
                          IsVisible="{Binding IsDetailsView}" />
                        <Path
                          Grid.Column="1"
                          Classes="menuIcon iconView"
                          Data="M1.5,3 H4 M5.5,3 H12 M1.5,7 H4 M5.5,7 H12 M1.5,11 H4 M5.5,11 H12" />
                      </Grid>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Click="ViewContextMenu_Click" Tag="LargeIcons">
                    <MenuItem.Header>
                      <TextBlock VerticalAlignment="Center" Text="大图标" />
                    </MenuItem.Header>
                    <MenuItem.Icon>
                      <Grid
                        Width="26"
                        ColumnDefinitions="8,14"
                        ColumnSpacing="4">
                        <Ellipse
                          Width="6"
                          Height="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="{DynamicResource HelloAccentBrush}"
                          IsVisible="{Binding IsLargeIconView}" />
                        <Path
                          Grid.Column="1"
                          Classes="menuIcon iconView"
                          Data="M1.5,1.5 H6 V6 H1.5 Z M8,1.5 H12.5 V6 H8 Z M1.5,8 H6 V12.5 H1.5 Z M8,8 H12.5 V12.5 H8 Z" />
                      </Grid>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Click="ViewContextMenu_Click" Tag="ExtraLargeIcons">
                    <MenuItem.Header>
                      <TextBlock VerticalAlignment="Center" Text="超大图标" />
                    </MenuItem.Header>
                    <MenuItem.Icon>
                      <Grid
                        Width="26"
                        ColumnDefinitions="8,14"
                        ColumnSpacing="4">
                        <Ellipse
                          Width="6"
                          Height="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="{DynamicResource HelloAccentBrush}"
                          IsVisible="{Binding IsExtraLargeIconView}" />
                        <Path
                          Grid.Column="1"
                          Classes="menuIcon iconView"
                          Data="M1.5,1.5 H7 V7 H1.5 Z M8.5,1.5 H12.5 V7 H8.5 Z M1.5,8.5 H7 V12.5 H1.5 Z M8.5,8.5 H12.5 V12.5 H8.5 Z" />
                      </Grid>
                    </MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button Classes="viewMode" ToolTip.Tip="排序">
              <Path
                Width="12"
                Height="12"
                Classes="toolbarIcon iconSort"
                Data="M2,3 H11 M4,7 H11 M6,11 H11" />
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Click="SortMenu_Click" Tag="Inherit:Default">
                    <MenuItem.Header>
                      <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                        <Ellipse
                          Width="6"
                          Height="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="{DynamicResource HelloAccentBrush}"
                          IsVisible="{Binding IsSystemDefaultSort}" />
                        <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Text="系统默认" />
                      </Grid>
                    </MenuItem.Header>
                  </MenuItem>
                  <Separator />
                  <MenuItem Click="SortMenu_Click" Tag="Name:Ascending">
                    <MenuItem.Header>
                      <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                        <Ellipse
                          Width="6"
                          Height="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="{DynamicResource HelloAccentBrush}"
                          IsVisible="{Binding IsNameAscendingSort}" />
                        <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Text="名称 · 升序" />
                      </Grid>
                    </MenuItem.Header>
                  </MenuItem>
                  <MenuItem Click="SortMenu_Click" Tag="Name:Descending">
                    <MenuItem.Header>
                      <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                        <Ellipse
                          Width="6"
                          Height="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="{DynamicResource HelloAccentBrush}"
                          IsVisible="{Binding IsNameDescendingSort}" />
                        <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Text="名称 · 降序" />
                      </Grid>
                    </MenuItem.Header>
                  </MenuItem>
                  <MenuItem Click="SortMenu_Click" Tag="Modified:Ascending">
                    <MenuItem.Header>
                      <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                        <Ellipse
                          Width="6"
                          Height="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="{DynamicResource HelloAccentBrush}"
                          IsVisible="{Binding IsModifiedAscendingSort}" />
                        <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Text="日期 · 升序" />
                      </Grid>
                    </MenuItem.Header>
                  </MenuItem>
                  <MenuItem Click="SortMenu_Click" Tag="Modified:Descending">
                    <MenuItem.Header>
                      <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                        <Ellipse
                          Width="6"
                          Height="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="{DynamicResource HelloAccentBrush}"
                          IsVisible="{Binding IsModifiedDescendingSort}" />
                        <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Text="日期 · 降序" />
                      </Grid>
                    </MenuItem.Header>
                  </MenuItem>
                  <MenuItem Click="SortMenu_Click" Tag="Size:Ascending">
                    <MenuItem.Header>
                      <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                        <Ellipse
                          Width="6"
                          Height="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="{DynamicResource HelloAccentBrush}"
                          IsVisible="{Binding IsSizeAscendingSort}" />
                        <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Text="大小 · 升序" />
                      </Grid>
                    </MenuItem.Header>
                  </MenuItem>
                  <MenuItem Click="SortMenu_Click" Tag="Size:Descending">
                    <MenuItem.Header>
                      <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                        <Ellipse
                          Width="6"
                          Height="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="{DynamicResource HelloAccentBrush}"
                          IsVisible="{Binding IsSizeDescendingSort}" />
                        <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Text="大小 · 降序" />
                      </Grid>
                    </MenuItem.Header>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>

          <ScrollViewer
            Grid.Row="1"
            Grid.ColumnSpan="2"
            HorizontalScrollBarVisibility="Auto"
            IsVisible="{OnFormFactor Desktop=False,
                                     Mobile=True}"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel
              VerticalAlignment="Center"
              Orientation="Horizontal"
              Spacing="6">
              <Button
                Classes="toolbar"
                Command="{Binding GoRootCommand}"
                ToolTip.Tip="主页">
                <Path Classes="toolbarIcon iconHome" Data="M1.5,6.2 L7,1.8 L12.5,6.2 M3.5,5.1 V11.5 H10.5 V5.1" />
              </Button>
              <Button
                Classes="toolbar"
                Command="{Binding RefreshCommand}"
                ToolTip.Tip="刷新">
                <Path Classes="toolbarIcon iconRefresh" Data="M11.6,5 A5,5 0 1 0 11,9.5 M11.6,5 V2 M11.6,5 H8.6" />
              </Button>
              <Button
                Classes="toolbar"
                Click="DownloadButton_Click"
                IsEnabled="{Binding HasDownloadableSelection}"
                ToolTip.Tip="下载">
                <Path Classes="toolbarIcon iconDownload" Data="M7,1.5 V9 M4.5,6.5 L7,9 L9.5,6.5 M2,11.5 H12" />
              </Button>
              <Button
                Classes="toolbar"
                Command="{Binding BeginCreateFolderCommand}"
                ToolTip.Tip="新建文件夹">
                <Path Classes="toolbarIcon iconFolder opticalUp" Data="M1.5,3.5 H5 L6.5,5 H12.5 V11.5 H1.5 Z M9,6.7 V9.8 M7.45,8.25 H10.55" />
              </Button>
              <Button
                Classes="toolbar"
                Command="{Binding BeginRenameCommand}"
                IsEnabled="{Binding HasSingleSelection}"
                ToolTip.Tip="重命名">
                <Path Classes="toolbarIcon iconRename" Data="M2,11.5 L2.7,8.8 L9.7,1.8 L12.2,4.3 L5.2,11.3 Z M8.5,3 L11,5.5" />
              </Button>
              <Button
                Classes="toolbar"
                Command="{Binding BeginDeleteCommand}"
                IsEnabled="{Binding HasSelection}"
                ToolTip.Tip="删除">
                <Path Classes="toolbarIcon iconDanger" Data="M3,4 H11 M5,4 V2.5 H9 V4 M4,5.5 L4.6,12 H9.4 L10,5.5 M6,6.7 V10 M8,6.7 V10" />
              </Button>
              <Border
                Width="1"
                Margin="4,4"
                Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
              <Button
                Classes="viewMode"
                Click="MobileSortButton_Click"
                ToolTip.Tip="排序">
                <Path
                  Width="12"
                  Height="12"
                  Classes="toolbarIcon iconSort"
                  Data="M2,3 H11 M4,7 H11 M6,11 H11" />
              </Button>
              <Button
                Classes="viewMode"
                Click="MobileViewModeButton_Click"
                ToolTip.Tip="查看方式">
                <Path Classes="toolbarIcon iconView opticalUp" Data="M1.5,2.4 H5.4 M1.5,7 H5.4 M1.5,11.6 H5.4 M8.4,2.4 H11.8 V5.8 H8.4 Z M8.4,8.2 H11.8 V11.6 H8.4 Z" />
              </Button>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <!--  Content  -->
      <Grid
        x:Name="FileArea"
        Grid.Row="2"
        Margin="0"
        ClipToBounds="True"
        SizeChanged="FileArea_SizeChanged">
        <Grid.ContextMenu>
          <ContextMenu>
            <MenuItem Command="{Binding RefreshCommand}" Header="刷新">
              <MenuItem.Icon>
                <Path Classes="menuIcon iconRefresh" Data="M11.6,5 A5,5 0 1 0 11,9.5 M11.6,5 V2 M11.6,5 H8.6" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="查看">
              <MenuItem.Icon>
                <Path Classes="menuIcon iconView" Data="M1.5,3 H4 M5.5,3 H12 M1.5,7 H4 M5.5,7 H12 M1.5,11 H4 M5.5,11 H12" />
              </MenuItem.Icon>
              <MenuItem Click="ViewContextMenu_Click" Tag="Details">
                <MenuItem.Header>
                  <TextBlock VerticalAlignment="Center" Text="详细信息" />
                </MenuItem.Header>
                <MenuItem.Icon>
                  <Grid
                    Width="26"
                    ColumnDefinitions="8,14"
                    ColumnSpacing="4">
                    <Ellipse
                      Width="6"
                      Height="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Fill="{DynamicResource HelloAccentBrush}"
                      IsVisible="{Binding IsDetailsView}" />
                    <Path
                      Grid.Column="1"
                      Classes="menuIcon iconView"
                      Data="M1.5,3 H4 M5.5,3 H12 M1.5,7 H4 M5.5,7 H12 M1.5,11 H4 M5.5,11 H12" />
                  </Grid>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Click="ViewContextMenu_Click" Tag="LargeIcons">
                <MenuItem.Header>
                  <TextBlock VerticalAlignment="Center" Text="大图标" />
                </MenuItem.Header>
                <MenuItem.Icon>
                  <Grid
                    Width="26"
                    ColumnDefinitions="8,14"
                    ColumnSpacing="4">
                    <Ellipse
                      Width="6"
                      Height="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Fill="{DynamicResource HelloAccentBrush}"
                      IsVisible="{Binding IsLargeIconView}" />
                    <Path
                      Grid.Column="1"
                      Classes="menuIcon iconView"
                      Data="M1.5,1.5 H6 V6 H1.5 Z M8,1.5 H12.5 V6 H8 Z M1.5,8 H6 V12.5 H1.5 Z M8,8 H12.5 V12.5 H8 Z" />
                  </Grid>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Click="ViewContextMenu_Click" Tag="ExtraLargeIcons">
                <MenuItem.Header>
                  <TextBlock VerticalAlignment="Center" Text="超大图标" />
                </MenuItem.Header>
                <MenuItem.Icon>
                  <Grid
                    Width="26"
                    ColumnDefinitions="8,14"
                    ColumnSpacing="4">
                    <Ellipse
                      Width="6"
                      Height="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Fill="{DynamicResource HelloAccentBrush}"
                      IsVisible="{Binding IsExtraLargeIconView}" />
                    <Path
                      Grid.Column="1"
                      Classes="menuIcon iconView"
                      Data="M1.5,1.5 H7 V7 H1.5 Z M8.5,1.5 H12.5 V7 H8.5 Z M1.5,8.5 H7 V12.5 H1.5 Z M8.5,8.5 H12.5 V12.5 H8.5 Z" />
                  </Grid>
                </MenuItem.Icon>
              </MenuItem>
            </MenuItem>
            <MenuItem Header="排序方式">
              <MenuItem.Icon>
                <Path Classes="menuIcon iconSort" Data="M2,3 H11 M4,7 H11 M6,11 H11" />
              </MenuItem.Icon>
              <MenuItem Click="SortMenu_Click" Tag="Inherit:Default">
                <MenuItem.Header>
                  <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                    <Ellipse
                      Width="6"
                      Height="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Fill="{DynamicResource HelloAccentBrush}"
                      IsVisible="{Binding IsSystemDefaultSort}" />
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Text="系统默认" />
                  </Grid>
                </MenuItem.Header>
              </MenuItem>
              <Separator />
              <MenuItem Click="SortMenu_Click" Tag="Name:Ascending">
                <MenuItem.Header>
                  <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                    <Ellipse
                      Width="6"
                      Height="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Fill="{DynamicResource HelloAccentBrush}"
                      IsVisible="{Binding IsNameAscendingSort}" />
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Text="名称 · 升序" />
                  </Grid>
                </MenuItem.Header>
                <MenuItem.Icon>
                  <Path Classes="menuIcon iconSort" Data="M4,11 V3 M2,5 L4,3 L6,5 M8,4 H12 M8,7 H11 M8,10 H10" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Click="SortMenu_Click" Tag="Name:Descending">
                <MenuItem.Header>
                  <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                    <Ellipse
                      Width="6"
                      Height="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Fill="{DynamicResource HelloAccentBrush}"
                      IsVisible="{Binding IsNameDescendingSort}" />
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Text="名称 · 降序" />
                  </Grid>
                </MenuItem.Header>
                <MenuItem.Icon>
                  <Path Classes="menuIcon iconSort" Data="M4,3 V11 M2,9 L4,11 L6,9 M8,4 H12 M8,7 H11 M8,10 H10" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Click="SortMenu_Click" Tag="Modified:Ascending">
                <MenuItem.Header>
                  <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                    <Ellipse
                      Width="6"
                      Height="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Fill="{DynamicResource HelloAccentBrush}"
                      IsVisible="{Binding IsModifiedAscendingSort}" />
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Text="日期 · 升序" />
                  </Grid>
                </MenuItem.Header>
                <MenuItem.Icon>
                  <Path Classes="menuIcon iconSort" Data="M4,11 V3 M2,5 L4,3 L6,5 M8,3 H12 M8,7 H11 M8,11 H10" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Click="SortMenu_Click" Tag="Modified:Descending">
                <MenuItem.Header>
                  <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                    <Ellipse
                      Width="6"
                      Height="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Fill="{DynamicResource HelloAccentBrush}"
                      IsVisible="{Binding IsModifiedDescendingSort}" />
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Text="日期 · 降序" />
                  </Grid>
                </MenuItem.Header>
                <MenuItem.Icon>
                  <Path Classes="menuIcon iconSort" Data="M4,3 V11 M2,9 L4,11 L6,9 M8,3 H12 M8,7 H11 M8,11 H10" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Click="SortMenu_Click" Tag="Size:Ascending">
                <MenuItem.Header>
                  <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                    <Ellipse
                      Width="6"
                      Height="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Fill="{DynamicResource HelloAccentBrush}"
                      IsVisible="{Binding IsSizeAscendingSort}" />
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Text="大小 · 升序" />
                  </Grid>
                </MenuItem.Header>
                <MenuItem.Icon>
                  <Path Classes="menuIcon iconSort" Data="M4,11 V3 M2,5 L4,3 L6,5 M8,10 H12 M8,7 H11 M8,4 H10" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Click="SortMenu_Click" Tag="Size:Descending">
                <MenuItem.Header>
                  <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                    <Ellipse
                      Width="6"
                      Height="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Fill="{DynamicResource HelloAccentBrush}"
                      IsVisible="{Binding IsSizeDescendingSort}" />
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Text="大小 · 降序" />
                  </Grid>
                </MenuItem.Header>
                <MenuItem.Icon>
                  <Path Classes="menuIcon iconSort" Data="M4,3 V11 M2,9 L4,11 L6,9 M8,10 H12 M8,7 H11 M8,4 H10" />
                </MenuItem.Icon>
              </MenuItem>
            </MenuItem>
            <MenuItem Command="{Binding GoRootCommand}" Header="返回主页">
              <MenuItem.Icon>
                <Path Classes="menuIcon iconHome" Data="M1.5,6.2 L7,1.8 L12.5,6.2 M3.5,5.1 V11.5 H10.5 V5.1" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Click="FileArea_Upload_Click" Header="上传文件">
              <MenuItem.Icon>
                <Path Classes="menuIcon iconTransferUp" Data="M7,12 V2 M3.5,5.5 L7,2 L10.5,5.5 M2,12 H12" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="FileArea_NewFolder_Click" Header="新建文件夹">
              <MenuItem.Icon>
                <Path Classes="menuIcon iconFolder" Data="M1.5,3.5 H5 L6.5,5 H12.5 V11.5 H1.5 Z M9,6.7 V9.8 M7.45,8.25 H10.55" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Grid.ContextMenu>
        <!--  Desktop hot path: exactly one ScrollViewer and one retained virtual drawing surface.  -->
        <Grid IsVisible="{OnFormFactor Desktop=True, Mobile=False}" RowDefinitions="Auto,*">
          <Border
            x:Name="DesktopDetailsHeaderBorder"
            Grid.Row="0"
            Padding="{OnFormFactor Desktop='8,4',
                                   Mobile='6,4'}"
            Background="Transparent"
            IsVisible="{Binding IsDetailsView}">
            <Grid ColumnDefinitions="{OnFormFactor Desktop='42,*,150,130,190', Mobile='38,*,90'}" ColumnSpacing="6">
              <Button
                Grid.Column="0"
                Padding="0"
                HorizontalContentAlignment="Center"
                Classes="headerSort"
                IsVisible="{OnFormFactor Desktop=True,
                                         Mobile=False}"
                ToolTip.Tip="排序">
                <Path
                  Width="12"
                  Height="12"
                  Classes="toolbarIcon iconSort"
                  Data="M2,3 H11 M4,7 H11 M6,11 H11" />
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Click="SortMenu_Click" Tag="Inherit:Default">
                      <MenuItem.Header>
                        <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                          <Ellipse
                            Width="6"
                            Height="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource HelloAccentBrush}"
                            IsVisible="{Binding IsSystemDefaultSort}" />
                          <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="系统默认" />
                        </Grid>
                      </MenuItem.Header>
                    </MenuItem>
                    <Separator />
                    <MenuItem Click="SortMenu_Click" Tag="Name:Ascending">
                      <MenuItem.Header>
                        <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                          <Ellipse
                            Width="6"
                            Height="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource HelloAccentBrush}"
                            IsVisible="{Binding IsNameAscendingSort}" />
                          <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="名称 · 升序" />
                        </Grid>
                      </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Click="SortMenu_Click" Tag="Name:Descending">
                      <MenuItem.Header>
                        <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                          <Ellipse
                            Width="6"
                            Height="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource HelloAccentBrush}"
                            IsVisible="{Binding IsNameDescendingSort}" />
                          <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="名称 · 降序" />
                        </Grid>
                      </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Click="SortMenu_Click" Tag="Modified:Ascending">
                      <MenuItem.Header>
                        <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                          <Ellipse
                            Width="6"
                            Height="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource HelloAccentBrush}"
                            IsVisible="{Binding IsModifiedAscendingSort}" />
                          <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="日期 · 升序" />
                        </Grid>
                      </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Click="SortMenu_Click" Tag="Modified:Descending">
                      <MenuItem.Header>
                        <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                          <Ellipse
                            Width="6"
                            Height="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource HelloAccentBrush}"
                            IsVisible="{Binding IsModifiedDescendingSort}" />
                          <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="日期 · 降序" />
                        </Grid>
                      </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Click="SortMenu_Click" Tag="Size:Ascending">
                      <MenuItem.Header>
                        <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                          <Ellipse
                            Width="6"
                            Height="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource HelloAccentBrush}"
                            IsVisible="{Binding IsSizeAscendingSort}" />
                          <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="大小 · 升序" />
                        </Grid>
                      </MenuItem.Header>
                    </MenuItem>
                    <MenuItem Click="SortMenu_Click" Tag="Size:Descending">
                      <MenuItem.Header>
                        <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                          <Ellipse
                            Width="6"
                            Height="6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource HelloAccentBrush}"
                            IsVisible="{Binding IsSizeDescendingSort}" />
                          <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="大小 · 降序" />
                        </Grid>
                      </MenuItem.Header>
                    </MenuItem>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button
                Grid.Column="0"
                Padding="0"
                HorizontalContentAlignment="Center"
                Classes="headerSort"
                Click="MobileSortButton_Click"
                IsVisible="{OnFormFactor Desktop=False,
                                         Mobile=True}"
                ToolTip.Tip="排序">
                <Path
                  Width="12"
                  Height="12"
                  Classes="toolbarIcon iconSort"
                  Data="M2,3 H11 M4,7 H11 M6,11 H11" />
              </Button>
              <Button
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Classes="headerSort"
                Click="SortHeader_Click"
                Tag="Name">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="名称" />
                  <TextBlock
                    FontSize="10"
                    Foreground="{DynamicResource HelloIconSortBrush}"
                    Text="{Binding NameSortIndicator}" />
                </StackPanel>
              </Button>
              <Border
                Grid.Column="2"
                Padding="8,0"
                IsVisible="{OnFormFactor Desktop=True,
                                         Mobile=False}">
                <TextBlock VerticalAlignment="Center" Text="类型" />
              </Border>
              <Button
                Grid.Column="{OnFormFactor Desktop=3,
                                           Mobile=2}"
                HorizontalAlignment="Stretch"
                Classes="headerSort"
                Click="SortHeader_Click"
                Tag="Size">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="大小" />
                  <TextBlock
                    FontSize="10"
                    Foreground="{DynamicResource HelloIconSortBrush}"
                    Text="{Binding SizeSortIndicator}" />
                </StackPanel>
              </Button>
              <Button
                Grid.Column="4"
                HorizontalAlignment="Stretch"
                Classes="headerSort"
                Click="SortHeader_Click"
                IsVisible="{OnFormFactor Desktop=True,
                                         Mobile=False}"
                Tag="Modified">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="修改时间" />
                  <TextBlock
                    FontSize="10"
                    Foreground="{DynamicResource HelloIconSortBrush}"
                    Text="{Binding ModifiedSortIndicator}" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
          <ScrollViewer
            x:Name="DesktopVirtualScrollViewer"
            Grid.Row="1"
            Margin="0,0,4,0"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            ScrollChanged="FileListScrollViewer_ScrollChanged"
            SizeChanged="DesktopVirtualScrollViewer_SizeChanged"
            VerticalScrollBarVisibility="Auto">
            <controls:DesktopVirtualFileSurface
              x:Name="DesktopFileSurface"
              HorizontalAlignment="Stretch"
              ContextRequested="DesktopFileSurface_ContextRequested"
              DoubleTapped="DesktopFileSurface_DoubleTapped"
              ItemBackground="{DynamicResource HelloFileItemBrush}"
              Mode="{Binding ViewMode}"
              PointerPressed="DesktopFileSurface_PointerPressed"
              SelectionBrush="{DynamicResource HelloExplorerSelectionBrush}" />
          </ScrollViewer>
        </Grid>

        <!--  The Avalonia mobile fallback keeps its existing three mode-specific surfaces.  -->
        <Grid IsVisible="{OnFormFactor Desktop=False, Mobile=True}">
          <!--  Details  -->
          <Grid IsVisible="{Binding IsDetailsView}" RowDefinitions="Auto,*">
            <Border
              x:Name="DetailsHeaderBorder"
              Grid.Row="0"
              Padding="{OnFormFactor Desktop='8,4',
                                     Mobile='6,4'}"
              Background="Transparent">
              <Grid ColumnDefinitions="{OnFormFactor Desktop='42,*,150,130,190', Mobile='38,*,90'}" ColumnSpacing="6">
                <Button
                  Grid.Column="0"
                  Padding="0"
                  HorizontalContentAlignment="Center"
                  Classes="headerSort"
                  IsVisible="{OnFormFactor Desktop=True,
                                           Mobile=False}"
                  ToolTip.Tip="排序">
                  <Path
                    Width="12"
                    Height="12"
                    Classes="toolbarIcon iconSort"
                    Data="M2,3 H11 M4,7 H11 M6,11 H11" />
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem Click="SortMenu_Click" Tag="Inherit:Default">
                        <MenuItem.Header>
                          <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                            <Ellipse
                              Width="6"
                              Height="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{DynamicResource HelloAccentBrush}"
                              IsVisible="{Binding IsSystemDefaultSort}" />
                            <TextBlock
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Text="系统默认" />
                          </Grid>
                        </MenuItem.Header>
                      </MenuItem>
                      <Separator />
                      <MenuItem Click="SortMenu_Click" Tag="Name:Ascending">
                        <MenuItem.Header>
                          <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                            <Ellipse
                              Width="6"
                              Height="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{DynamicResource HelloAccentBrush}"
                              IsVisible="{Binding IsNameAscendingSort}" />
                            <TextBlock
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Text="名称 · 升序" />
                          </Grid>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Click="SortMenu_Click" Tag="Name:Descending">
                        <MenuItem.Header>
                          <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                            <Ellipse
                              Width="6"
                              Height="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{DynamicResource HelloAccentBrush}"
                              IsVisible="{Binding IsNameDescendingSort}" />
                            <TextBlock
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Text="名称 · 降序" />
                          </Grid>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Click="SortMenu_Click" Tag="Modified:Ascending">
                        <MenuItem.Header>
                          <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                            <Ellipse
                              Width="6"
                              Height="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{DynamicResource HelloAccentBrush}"
                              IsVisible="{Binding IsModifiedAscendingSort}" />
                            <TextBlock
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Text="日期 · 升序" />
                          </Grid>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Click="SortMenu_Click" Tag="Modified:Descending">
                        <MenuItem.Header>
                          <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                            <Ellipse
                              Width="6"
                              Height="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{DynamicResource HelloAccentBrush}"
                              IsVisible="{Binding IsModifiedDescendingSort}" />
                            <TextBlock
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Text="日期 · 降序" />
                          </Grid>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Click="SortMenu_Click" Tag="Size:Ascending">
                        <MenuItem.Header>
                          <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                            <Ellipse
                              Width="6"
                              Height="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{DynamicResource HelloAccentBrush}"
                              IsVisible="{Binding IsSizeAscendingSort}" />
                            <TextBlock
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Text="大小 · 升序" />
                          </Grid>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Click="SortMenu_Click" Tag="Size:Descending">
                        <MenuItem.Header>
                          <Grid ColumnDefinitions="10,*" ColumnSpacing="6">
                            <Ellipse
                              Width="6"
                              Height="6"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{DynamicResource HelloAccentBrush}"
                              IsVisible="{Binding IsSizeDescendingSort}" />
                            <TextBlock
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Text="大小 · 降序" />
                          </Grid>
                        </MenuItem.Header>
                      </MenuItem>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
                <Button
                  Grid.Column="0"
                  Padding="0"
                  HorizontalContentAlignment="Center"
                  Classes="headerSort"
                  Click="MobileSortButton_Click"
                  IsVisible="{OnFormFactor Desktop=False,
                                           Mobile=True}"
                  ToolTip.Tip="排序">
                  <Path
                    Width="12"
                    Height="12"
                    Classes="toolbarIcon iconSort"
                    Data="M2,3 H11 M4,7 H11 M6,11 H11" />
                </Button>
                <Button
                  Grid.Column="1"
                  HorizontalAlignment="Stretch"
                  Classes="headerSort"
                  Click="SortHeader_Click"
                  Tag="Name">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="名称" />
                    <TextBlock
                      FontSize="10"
                      Foreground="{DynamicResource HelloIconSortBrush}"
                      Text="{Binding NameSortIndicator}" />
                  </StackPanel>
                </Button>
                <Border
                  Grid.Column="2"
                  Padding="8,0"
                  IsVisible="{OnFormFactor Desktop=True,
                                           Mobile=False}">
                  <TextBlock VerticalAlignment="Center" Text="类型" />
                </Border>
                <Button
                  Grid.Column="{OnFormFactor Desktop=3,
                                             Mobile=2}"
                  HorizontalAlignment="Stretch"
                  Classes="headerSort"
                  Click="SortHeader_Click"
                  Tag="Size">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="大小" />
                    <TextBlock
                      FontSize="10"
                      Foreground="{DynamicResource HelloIconSortBrush}"
                      Text="{Binding SizeSortIndicator}" />
                  </StackPanel>
                </Button>
                <Button
                  Grid.Column="4"
                  HorizontalAlignment="Stretch"
                  Classes="headerSort"
                  Click="SortHeader_Click"
                  IsVisible="{OnFormFactor Desktop=True,
                                           Mobile=False}"
                  Tag="Modified">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="修改时间" />
                    <TextBlock
                      FontSize="10"
                      Foreground="{DynamicResource HelloIconSortBrush}"
                      Text="{Binding ModifiedSortIndicator}" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <RefreshContainer
              Grid.Row="1"
              HorizontalContentAlignment="Stretch"
              VerticalContentAlignment="Stretch"
              IsVisible="{Binding UseAvaloniaMobileFileList}"
              PullDirection="TopToBottom"
              RefreshRequested="MobileRefreshContainer_RefreshRequested">
              <ScrollViewer
                x:Name="MobileDetailsScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                ScrollChanged="FileListScrollViewer_ScrollChanged"
                VerticalScrollBarVisibility="Hidden">
                <ItemsRepeater
                  x:Name="MobileDetailsRepeater"
                  ItemTemplate="{StaticResource MobileDetailsFileItemTemplate}"
                  ItemsSource="{Binding MobileItems}">
                  <ItemsRepeater.Layout>
                    <StackLayout Spacing="0" />
                  </ItemsRepeater.Layout>
                </ItemsRepeater>
              </ScrollViewer>
            </RefreshContainer>
          </Grid>

          <!--  Large icons  -->
          <Grid IsVisible="{Binding IsLargeIconView}">
            <RefreshContainer
              HorizontalContentAlignment="Stretch"
              VerticalContentAlignment="Stretch"
              IsVisible="{Binding UseAvaloniaMobileFileList}"
              PullDirection="TopToBottom"
              RefreshRequested="MobileRefreshContainer_RefreshRequested">
              <ScrollViewer
                x:Name="MobileLargeIconScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                ScrollChanged="FileListScrollViewer_ScrollChanged"
                SizeChanged="MobileIconScrollViewer_SizeChanged"
                VerticalScrollBarVisibility="Hidden">
                <ItemsRepeater
                  x:Name="MobileLargeIconRepeater"
                  ItemTemplate="{StaticResource MobileLargeFileItemTemplate}"
                  ItemsSource="{Binding MobileItems}">
                  <ItemsRepeater.Layout>
                    <UniformGridLayout
                      MinColumnSpacing="4"
                      MinItemHeight="146"
                      MinItemWidth="108"
                      MinRowSpacing="4" />
                  </ItemsRepeater.Layout>
                </ItemsRepeater>
              </ScrollViewer>
            </RefreshContainer>
          </Grid>

          <!--  Extra large icons  -->
          <Grid IsVisible="{Binding IsExtraLargeIconView}">
            <RefreshContainer
              HorizontalContentAlignment="Stretch"
              VerticalContentAlignment="Stretch"
              IsVisible="{Binding UseAvaloniaMobileFileList}"
              PullDirection="TopToBottom"
              RefreshRequested="MobileRefreshContainer_RefreshRequested">
              <ScrollViewer
                x:Name="MobileExtraLargeIconScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                ScrollChanged="FileListScrollViewer_ScrollChanged"
                SizeChanged="MobileIconScrollViewer_SizeChanged"
                VerticalScrollBarVisibility="Hidden">
                <ItemsRepeater
                  x:Name="MobileExtraLargeIconRepeater"
                  ItemTemplate="{StaticResource MobileExtraLargeFileItemTemplate}"
                  ItemsSource="{Binding MobileItems}">
                  <ItemsRepeater.Layout>
                    <UniformGridLayout
                      MinColumnSpacing="4"
                      MinItemHeight="188"
                      MinItemWidth="150"
                      MinRowSpacing="4" />
                  </ItemsRepeater.Layout>
                </ItemsRepeater>
              </ScrollViewer>
            </RefreshContainer>
          </Grid>

        </Grid>

        <!--
          Native mobile performance path: Android hosts RecyclerView and iOS hosts UICollectionView
          above the hidden Avalonia fallback surfaces.
        -->
        <!--
          The platform-native list is created lazily after authentication.  In particular,
          a clean first launch must not instantiate RecyclerView/UICollectionView behind the
          login page before the platform activity/view hierarchy has fully settled.
        -->
        <Grid
          x:Name="NativeMobileFileListContainer"
          Margin="0,42,0,0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          IsVisible="False" />

        <!--  Marquee selection + freely draggable upload button.  -->
        <Canvas IsHitTestVisible="False" ZIndex="800">
          <Border
            x:Name="SelectionMarquee"
            Background="{DynamicResource HelloExplorerMarqueeBrush}"
            BorderBrush="{DynamicResource HelloExplorerMarqueeBorderBrush}"
            BorderThickness="1"
            CornerRadius="2"
            IsHitTestVisible="False"
            IsVisible="False" />
        </Canvas>
      </Grid>

      <!--  Status  -->
      <Border
        x:Name="BottomStatusBar"
        Grid.Row="3"
        Padding="8,4"
        Background="Transparent"
        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
        BorderThickness="0,1,0,0">
        <TextBlock
          HorizontalAlignment="Left"
          Opacity="0.72"
          Text="{Binding ItemCountText}" />
      </Border>

      <!--  The floating upload button spans the whole app content and can be dragged freely.  -->
      <Canvas
        x:Name="FloatingActionCanvas"
        Grid.RowSpan="4"
        SizeChanged="FloatingActionCanvas_SizeChanged"
        ZIndex="850">
        <!--
          Use a separate transparent drag surface above the visual Button. Avalonia Button
          captures pointer input for its own pressed/click gesture, which made drag gestures
          unreliable on some desktop platforms. The drag surface owns the pointer instead;
          a release without movement is treated as the normal upload click.
        -->
        <Grid
          x:Name="FloatingUploadDragHost"
          Width="48"
          Height="48"
          IsVisible="{Binding ShowFloatingUploadButton}"
          ToolTip.Tip="上传文件">
          <Button
            x:Name="FloatingUploadButton"
            Classes="fab"
            IsHitTestVisible="False">
            <Path
              Width="17"
              Height="17"
              Data="M7,12 V2 M3.5,5.5 L7,2 L10.5,5.5 M2,12 H12"
              Stretch="Uniform"
              Stroke="#FFF7F8"
              StrokeLineCap="Round"
              StrokeThickness="1.5" />
          </Button>
          <Border
            Background="#01000000"
            CornerRadius="24"
            Cursor="Hand"
            PointerMoved="FloatingUploadButton_PointerMoved"
            PointerPressed="FloatingUploadButton_PointerPressed"
            PointerReleased="FloatingUploadButton_PointerReleased" />
        </Grid>
      </Canvas>
    </Grid>

    <!--
      Mobile contextual selection actions. A stationary long-press selects one item; additional
      items are toggled by taps. Drag-range selection is intentionally not used on phones so a
      slow scroll can never be mistaken for multi-selection.
    -->
    <Border
      x:Name="MobileSelectionActionBar"
      Margin="8,8,8,0"
      Padding="10,8"
      VerticalAlignment="Top"
      Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
      BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
      BorderThickness="1"
      BoxShadow="0 7 24 0 #42000000"
      CornerRadius="12"
      IsVisible="False"
      ZIndex="1500">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
        <TextBlock
          x:Name="MobileSelectionCountText"
          Grid.Row="0"
          FontWeight="SemiBold"
          Text="已选择 1 项" />
        <ScrollViewer
          Grid.Row="1"
          HorizontalScrollBarVisibility="Hidden"
          VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Padding="10,6" Click="MobileSelectionDownload_Click">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Classes="toolbarIcon iconDownload" Data="M7,1.5 V9 M4.5,6.5 L7,9 L9.5,6.5 M2,11.5 H12" />
                <TextBlock Text="下载" />
              </StackPanel>
            </Button>
            <Button Padding="10,6" Click="MobileSelectionCache_Click">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Classes="toolbarIcon iconCache" Data="M4,3 H10.5 A2,2 0 0 1 12.5,5 V10.5 A2,2 0 0 1 10.5,12.5 H3.5 A2,2 0 0 1 1.5,10.5 V5 A2,2 0 0 1 3.5,3 M4.5,6.2 H9.5 M4.5,9.2 H8" />
                <TextBlock Text="缓存" />
              </StackPanel>
            </Button>
            <Button Padding="10,6" Click="MobileSelectionShare_Click">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Classes="toolbarIcon iconOpen" Data="M5.2,8.8 L9.8,4.2 M7.5,3.2 H10.8 V6.5 M10.5,8.2 V11.5 H2.5 V3.5 H5.8" />
                <TextBlock Text="分享" />
              </StackPanel>
            </Button>
            <Button Padding="10,6" Click="MobileSelectionMove_Click">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Classes="toolbarIcon iconFolder" Data="M1.5,4 H5 L6.3,5.4 H12.5 V11.5 H1.5 Z M5,8 H10 M8,6 L10,8 L8,10" />
                <TextBlock Text="移动" />
              </StackPanel>
            </Button>
            <Button Padding="10,6" Click="MobileSelectionCopy_Click">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Classes="toolbarIcon iconView" Data="M4.5,4.5 H12 V12 H4.5 Z M2,9.5 V2 H9.5" />
                <TextBlock Text="复制" />
              </StackPanel>
            </Button>
            <Button Padding="10,6" Click="MobileSelectionDelete_Click">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Path Classes="toolbarIcon iconDanger" Data="M3,4 H11 M5,4 V2.5 H9 V4 M4,5.5 L4.6,12 H9.4 L10,5.5 M6,6.7 V10 M8,6.7 V10" />
                <TextBlock Text="删除" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <!--  Mobile OneDrive destination browser used by Move and Copy.  -->
    <Grid
      x:Name="MobileDestinationOverlay"
      Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
      IsVisible="False"
      ZIndex="2100">
      <Grid
        Margin="16,20,16,16"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="10">
        <StackPanel Grid.Row="0" Spacing="2">
          <TextBlock
            x:Name="MobileDestinationTitle"
            FontSize="24"
            FontWeight="SemiBold"
            Text="选择目标文件夹" />
          <TextBlock Classes="caption" Text="选择 OneDrive 中的目标位置" />
        </StackPanel>
        <ScrollViewer
          Grid.Row="1"
          HorizontalScrollBarVisibility="Hidden"
          VerticalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="MobileDestinationBreadcrumbs">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:BreadcrumbItem">
                <StackPanel Orientation="Horizontal" Spacing="1">
                  <Button
                    Padding="5,2"
                    Classes="breadcrumb"
                    Click="MobileDestinationBreadcrumb_Click"
                    Content="{Binding Name}" />
                  <TextBlock
                    VerticalAlignment="Center"
                    Opacity="0.42"
                    Text="›" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <ListBox
          x:Name="MobileDestinationFolderList"
          Grid.Row="2"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Hidden"
          SelectionMode="Single">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:DriveItemModel">
              <Button
                Padding="10,8"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Click="MobileDestinationFolder_Click">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Path
                    Grid.Column="0"
                    Width="24"
                    Height="24"
                    Classes="toolbarIcon iconFolder"
                    Data="M1.5,4 H5.2 L6.6,5.5 H12.5 V11.5 H1.5 Z"
                    Stretch="Uniform"
                    StrokeThickness="1.4" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                      FontWeight="SemiBold"
                      Text="{Binding Name}"
                      TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" Text="{Binding ChildCount, StringFormat='{}{0} 项'}" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Grid
          Grid.Row="3"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="8">
          <Button
            Grid.Column="0"
            Click="MobileDestinationCancel_Click"
            Content="取消" />
          <Button
            x:Name="MobileDestinationConfirmButton"
            Grid.Column="1"
            Classes="coral"
            Click="MobileDestinationConfirm_Click"
            Content="移动到这里" />
        </Grid>
      </Grid>
    </Grid>

    <!--  Mobile account page. It uses the exact same customizable background stack as the file page.  -->
    <Grid
      x:Name="MobileProfileOverlay"
      Background="Transparent"
      IsVisible="False"
      ZIndex="2050">
      <Border x:Name="MobileProfileBackgroundColor" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" />
      <Image
        x:Name="MobileProfileBackgroundImage"
        IsVisible="False"
        Stretch="UniformToFill" />
      <Border
        x:Name="MobileProfileBackgroundScrim"
        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
        Opacity="0.30" />

      <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <Grid
          Margin="20,24,20,18"
          RowDefinitions="Auto,Auto,Auto,*,Auto"
          RowSpacing="16">
          <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock
              FontSize="26"
              FontWeight="SemiBold"
              Text="个人账户" />
            <TextBlock Classes="caption" Text="Microsoft OneDrive" />
          </StackPanel>

          <Border
            Grid.Row="1"
            Padding="20,22"
            Background="#34000000"
            BorderBrush="#22FFFFFF"
            BorderThickness="1"
            CornerRadius="22">
            <StackPanel Spacing="16">
              <StackPanel HorizontalAlignment="Center" Spacing="8">
                <Grid Width="116" Height="116">
                  <Border
                    Background="{DynamicResource HelloAccentBrush}"
                    BoxShadow="0 7 24 0 #32000000"
                    CornerRadius="58">
                    <TextBlock
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontSize="38"
                      FontWeight="SemiBold"
                      Foreground="White"
                      Text="{Binding UserInitial}" />
                  </Border>
                  <Border
                    ClipToBounds="True"
                    CornerRadius="58"
                    IsVisible="{Binding HasUserAvatar}">
                    <Image Source="{Binding UserAvatar}" Stretch="UniformToFill" />
                  </Border>
                </Grid>
                <TextBlock
                  HorizontalAlignment="Center"
                  FontSize="21"
                  FontWeight="SemiBold"
                  Text="{Binding UserDisplayName}"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
                <TextBlock
                  HorizontalAlignment="Center"
                  Classes="caption"
                  Text="{Binding UserEmail}"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Margin="2,2,2,0" Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock FontWeight="SemiBold" Text="OneDrive 容量" />
                  <TextBlock
                    Grid.Column="1"
                    FontWeight="SemiBold"
                    Text="{Binding QuotaPercentText}" />
                </Grid>
                <ProgressBar
                  Height="9"
                  Background="#32FFFFFF"
                  Maximum="100"
                  Minimum="0"
                  Value="{Binding QuotaUsedPercent}">
                  <ProgressBar.Foreground>
                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                      <GradientStop Offset="0" Color="#38BDF8" />
                      <GradientStop Offset="0.52" Color="#6366F1" />
                      <GradientStop Offset="1" Color="#F472B6" />
                    </LinearGradientBrush>
                  </ProgressBar.Foreground>
                </ProgressBar>
                <TextBlock Classes="caption" Text="{Binding QuotaText}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Grid
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            RowDefinitions="Auto,Auto,Auto"
            RowSpacing="8">
            <Button
              Grid.Row="0"
              Height="50"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left"
              Background="Transparent"
              BorderThickness="0"
              Click="MobileProfileOpenWeb_Click"
              Content="进入 OneDrive 网页版" />
            <Button
              Grid.Row="1"
              Height="50"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left"
              Background="Transparent"
              BorderThickness="0"
              Click="MobileProfileSettings_Click"
              Content="设置" />
            <Button
              Grid.Row="2"
              Height="50"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left"
              Background="Transparent"
              BorderThickness="0"
              Click="MobileProfileLogout_Click"
              Content="退出登录" />
          </Grid>

          <StackPanel
            Grid.Row="4"
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            Opacity="0.72"
            Spacing="5">
            <Image
              Width="48"
              Height="48"
              HorizontalAlignment="Center"
              Source="/Assets/app-icon.png" />
            <TextBlock
              HorizontalAlignment="Center"
              FontSize="16"
              FontWeight="SemiBold"
              Text="Hello1Drive" />
            <TextBlock
              HorizontalAlignment="Center"
              Classes="caption"
              Text="{Binding AppVersionText}" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>

    <!--  Transfer list  -->
    <Border
      x:Name="TransferPanel"
      MinWidth="{OnFormFactor Desktop=400,
                              Mobile=0}"
      MaxWidth="{OnFormFactor Desktop=400,
                              Mobile=10000}"
      MaxHeight="{OnFormFactor Desktop=430,
                               Mobile=10000}"
      Margin="{OnFormFactor Desktop='18,18,18,56',
                            Mobile='0'}"
      Padding="{OnFormFactor Desktop='16',
                             Mobile='16,20,16,12'}"
      HorizontalAlignment="{OnFormFactor Desktop=Right,
                                         Mobile=Stretch}"
      VerticalAlignment="{OnFormFactor Desktop=Bottom,
                                       Mobile=Stretch}"
      Background="Transparent"
      BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
      BorderThickness="{OnFormFactor Desktop='1',
                                     Mobile='0'}"
      BoxShadow="0 8 28 0 #40000000"
      CornerRadius="{OnFormFactor Desktop=12,
                                  Mobile=0}"
      IsVisible="{Binding IsTransferPanelVisible}"
      ZIndex="1950">
      <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Border
          Grid.RowSpan="2"
          Margin="-16"
          Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
          IsVisible="{OnFormFactor Desktop=True,
                                   Mobile=False}" />
        <Border
          x:Name="MobileTransferBackgroundColor"
          Grid.RowSpan="2"
          Margin="-16,-20,-16,-12"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          IsVisible="{OnFormFactor Desktop=False,
                                   Mobile=True}" />
        <Image
          x:Name="MobileTransferBackgroundImage"
          Grid.RowSpan="2"
          Margin="-16,-20,-16,-12"
          IsVisible="False"
          Stretch="UniformToFill" />
        <Border
          x:Name="MobileTransferBackgroundScrim"
          Grid.RowSpan="2"
          Margin="-16,-20,-16,-12"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          IsVisible="{OnFormFactor Desktop=False,
                                   Mobile=True}"
          Opacity="0.30" />
        <Grid
          Grid.Row="0"
          ColumnDefinitions="*,Auto,Auto"
          ColumnSpacing="8">
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock
              FontSize="18"
              FontWeight="SemiBold"
              Text="传输列表" />
            <TextBlock Classes="caption" Text="{Binding TransferSummaryText}" />
          </StackPanel>
          <Button
            Grid.Column="1"
            Command="{Binding ClearFinishedTransfersCommand}"
            Content="清理完成" />
          <Button
            Grid.Column="2"
            Classes="iconCloseGlyph"
            Command="{Binding ToggleTransfersCommand}"
            Content="×"
            IsVisible="{OnFormFactor Desktop=True,
                                     Mobile=False}" />
        </Grid>
        <!--
          ListBox uses Avalonia's virtualizing stack panel by default, so thousands of queued transfers
          no longer create thousands of visual rows at once.
        -->
        <ListBox
          Grid.Row="1"
          Classes="transferList"
          ItemsSource="{Binding Transfers}"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:TransferItemModel">
              <Border
                Margin="0,0,0,8"
                Padding="10"
                Background="Transparent"
                CornerRadius="8"
                ToolTip.Tip="{Binding Message}">
                <Grid
                  ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="7"
                  RowDefinitions="Auto,Auto"
                  RowSpacing="6">
                  <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    FontWeight="SemiBold"
                    Text="{Binding FileName}"
                    TextTrimming="CharacterEllipsis" />
                  <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="caption"
                    Text="{Binding StateProgressText}" />
                  <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    Width="25"
                    Height="25"
                    Padding="5"
                    Classes="titleToolbar"
                    Click="RetryTransferButton_Click"
                    IsVisible="{Binding CanRetry}"
                    ToolTip.Tip="重试">
                    <Path
                      Width="11"
                      Height="11"
                      Classes="toolbarIcon iconRetry"
                      Data="M10.8,4.8 A4.6,4.6 0 1 0 10.4,9.3 M10.8,4.8 V2 M10.8,4.8 H8.2" />
                  </Button>
                  <ProgressBar
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Height="4"
                    Maximum="1"
                    Minimum="0"
                    Value="{Binding Progress}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!--  Preview overlay: click outside preview card to close  -->
    <Grid
      x:Name="PreviewOverlay"
      Background="#B0000000"
      Focusable="True"
      IsVisible="{Binding IsPreviewVisible}"
      Opacity="0"
      PointerPressed="PreviewOverlay_PointerPressed"
      ZIndex="1600">
      <Grid.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:00:00.140" />
        </Transitions>
      </Grid.Transitions>
      <Border
        x:Name="PreviewCard"
        Margin="{OnFormFactor Desktop='70,55',
                              Mobile='0'}"
        Padding="{OnFormFactor Desktop='16',
                               Mobile='12'}"
        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
        BorderBrush="#45FFFFFF"
        BorderThickness="1"
        CornerRadius="{OnFormFactor Desktop=14,
                                    Mobile=0}"
        Opacity="0"
        PointerPressed="OverlayContent_PointerPressed">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:00:00.200" />
          </Transitions>
        </Border.Transitions>
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
          <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12">
            <StackPanel>
              <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Text="{Binding PreviewItem.Name}"
                TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="caption" Text="{Binding PreviewDetails}" />
            </StackPanel>
            <Button
              Grid.Column="1"
              Classes="icon iconCloseGlyph"
              Command="{Binding ClosePreviewCommand}"
              Content="×"
              IsVisible="{OnFormFactor Desktop=True,
                                       Mobile=False}" />
            <Button
              Grid.Column="1"
              Width="34"
              Height="34"
              Padding="0"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Background="Transparent"
              Classes="icon"
              Click="PreviewMore_Click"
              IsVisible="{OnFormFactor Desktop=False,
                                       Mobile=True}"
              ToolTip.Tip="更多">
              <Path
                Width="16"
                Height="16"
                Margin="8,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="M7,2.2 A1.25,1.25 0 1 1 7,4.7 A1.25,1.25 0 0 1 7,2.2 Z M7,6 A1.25,1.25 0 1 1 7,8.5 A1.25,1.25 0 0 1 7,6 Z M7,9.8 A1.25,1.25 0 1 1 7,12.3 A1.25,1.25 0 0 1 7,9.8 Z"
                Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                Stretch="Uniform" />
            </Button>
          </Grid>

          <Grid Grid.Row="1">
            <!--  Text editor  -->
            <Grid
              IsVisible="{Binding IsTextPreview}"
              RowDefinitions="*,Auto"
              RowSpacing="8">
              <TextBox
                Grid.Row="0"
                AcceptsReturn="True"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{Binding PreviewText, Mode=TwoWay}"
                TextWrapping="NoWrap" />
              <Button
                Grid.Row="1"
                Padding="18,8"
                HorizontalAlignment="Right"
                Classes="coral"
                Command="{Binding SavePreviewTextCommand}"
                Content="保存修改" />
            </Grid>

            <!--
              Image/GIF viewer. On mobile the built-in Carousel provides direct-manipulation
              paging: the current and adjacent images follow the finger during a swipe.
              Pinch/double-tap switches to the dedicated zoom canvas so an enlarged image pans
              instead of competing with horizontal page navigation. Desktop keeps the original
              canvas viewer and mouse-wheel zoom behavior.
            -->
            <Grid
              x:Name="PreviewImageViewport"
              ClipToBounds="True"
              ContextRequested="PreviewImage_ContextRequested"
              DoubleTapped="PreviewImage_DoubleTapped"
              IsVisible="{Binding IsImagePreview}"
              PointerMoved="PreviewImage_PointerMoved"
              PointerPressed="PreviewImage_PointerPressed"
              PointerReleased="PreviewImage_PointerReleased"
              PointerWheelChanged="PreviewImage_PointerWheelChanged"
              SizeChanged="PreviewImageViewport_SizeChanged">
              <Grid.ContextMenu>
                <ContextMenu x:Name="PreviewImageContextMenu">
                  <MenuItem Click="PreviewPrevious_Click" Header="上一张">
                    <MenuItem.Icon>
                      <Path Classes="menuIcon iconPreview" Data="M10.5,2 L4,7 L10.5,12" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Click="PreviewNext_Click" Header="下一张">
                    <MenuItem.Icon>
                      <Path Classes="menuIcon iconPreview" Data="M3.5,2 L10,7 L3.5,12" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Click="PreviewSlideshow_Click" Header="{Binding SlideshowText}">
                    <MenuItem.Icon>
                      <Path Classes="menuIcon iconTransferUp" Data="M4,3 L11,7 L4,11 Z" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator />
                  <MenuItem Click="PreviewDownload_Click" Header="下载">
                    <MenuItem.Icon>
                      <Path Classes="menuIcon iconDownload" Data="M7,1.5 V9 M4.5,6.5 L7,9 L9.5,6.5 M2,11.5 H12" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Click="PreviewDetails_Click" Header="详细信息">
                    <MenuItem.Icon>
                      <Path Classes="menuIcon iconView" Data="M7,2.2 A4.8,4.8 0 1 1 7,11.8 A4.8,4.8 0 0 1 7,2.2 Z M7,6.2 V10 M7,4.2 V4.3" />
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </Grid.ContextMenu>

              <Carousel
                x:Name="MobileImageCarousel"
                IsSwipeEnabled="True"
                IsVisible="{OnFormFactor Desktop=False,
                                         Mobile=True}"
                SelectionChanged="MobileImageCarousel_SelectionChanged"
                ViewportFraction="1"
                WrapSelection="False">
                <Carousel.PageTransition>
                  <PageSlide Orientation="Horizontal" Duration="0:00:00.180" />
                </Carousel.PageTransition>
                <Carousel.ItemTemplate>
                  <DataTemplate x:DataType="models:DriveItemModel">
                    <Grid Background="Transparent" ClipToBounds="True">
                      <Viewbox
                        Width="96"
                        Height="96"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform">
                        <Canvas Width="32" Height="32">
                          <Border
                            Canvas.Left="2"
                            Canvas.Top="2"
                            Width="28"
                            Height="28"
                            Background="#EEF7FF"
                            BorderBrush="#8EC5FF"
                            BorderThickness="1.2"
                            CornerRadius="7" />
                          <Path
                            Data="M7,23 L12,16.5 L16,20 L20,15.5 L25,23"
                            Fill="Transparent"
                            Stroke="#3B82F6"
                            StrokeJoin="Round"
                            StrokeLineCap="Round"
                            StrokeThickness="1.8" />
                          <Ellipse
                            Canvas.Left="8"
                            Canvas.Top="8"
                            Width="5"
                            Height="5"
                            Fill="#FDBA74" />
                        </Canvas>
                      </Viewbox>
                      <Image
                        IsVisible="{Binding HasThumbnailImage}"
                        Source="{Binding ThumbnailImage}"
                        Stretch="Uniform" />
                      <Image
                        IsVisible="{Binding HasGalleryImage}"
                        Source="{Binding GalleryImage}"
                        Stretch="Uniform" />
                    </Grid>
                  </DataTemplate>
                </Carousel.ItemTemplate>
              </Carousel>

              <Canvas
                x:Name="PreviewZoomCanvas"
                ClipToBounds="True"
                IsVisible="{OnFormFactor Desktop=True,
                                         Mobile=False}">
                <Image
                  x:Name="PreviewImageElement"
                  Width="{Binding PreviewImageWidth}"
                  Height="{Binding PreviewImageHeight}"
                  Source="{Binding PreviewImage}"
                  Stretch="Fill" />
              </Canvas>

              <Border
                Margin="0,8,0,0"
                Padding="9,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#88000000"
                CornerRadius="12"
                IsHitTestVisible="False">
                <TextBlock
                  FontSize="12"
                  Foreground="White"
                  Text="{Binding PreviewZoomText}" />
              </Border>
            </Grid>

            <!--
              Media: platform heads can provide a true in-app player. The desktop head
              registers a LibVLCSharp player; unsupported targets keep the system-player fallback.
            -->
            <Grid IsVisible="{Binding IsMediaPreview}">
              <ContentControl
                x:Name="EmbeddedMediaPlayerHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsVisible="False" />
              <StackPanel
                x:Name="ExternalMediaFallback"
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14">
                <TextBlock
                  HorizontalAlignment="Center"
                  FontSize="78"
                  Text="▶" />
                <TextBlock
                  FontSize="20"
                  FontWeight="SemiBold"
                  Text="{Binding PreviewItem.Name}"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
                <TextBlock
                  Opacity="0.7"
                  Text="当前平台未启用内置播放器，可使用系统应用打开。"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
                <Button
                  Padding="20,9"
                  HorizontalAlignment="Center"
                  Classes="coral"
                  Click="OpenMediaButton_Click"
                  Content="使用系统应用打开" />
              </StackPanel>
            </Grid>

            <StackPanel
              MaxWidth="560"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsVisible="{Binding ShowGenericPreview}"
              Spacing="12">
              <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="{Binding PreviewItem.Name}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
              <TextBlock
                Opacity="0.7"
                Text="{Binding PreviewStatus}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
              <Button
                Padding="20,9"
                HorizontalAlignment="Center"
                Classes="coral"
                Click="OpenPreviewWithSystemApp_Click"
                Content="使用系统应用打开" />
            </StackPanel>

            <Grid
              Background="Transparent"
              IsHitTestVisible="True"
              IsVisible="{Binding IsPreviewLoading}"
              ZIndex="20">
              <controls:LoadingIndicator HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Grid>

          <Border
            Grid.Row="2"
            Padding="12,9"
            Background="#26000000"
            CornerRadius="9"
            IsVisible="{Binding IsPreviewDetailsVisible}">
            <TextBlock
              FontSize="12"
              Opacity="0.84"
              Text="{Binding PreviewExtendedDetails}"
              TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!--  Mobile view-mode action panel. It intentionally mirrors the mobile sort surface.  -->
    <Grid
      x:Name="MobileViewModeActionsOverlay"
      Background="#72000000"
      IsVisible="False"
      PointerPressed="MobileViewModeActionsBackdrop_PointerPressed"
      ZIndex="3200">
      <Border
        MaxWidth="420"
        Margin="28"
        Padding="0,8"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center"
        Background="#F0444444"
        BorderBrush="#28FFFFFF"
        BorderThickness="1"
        CornerRadius="8"
        PointerPressed="OverlayContent_PointerPressed">
        <StackPanel HorizontalAlignment="Stretch">
          <Button
            Height="58"
            Padding="20,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="MobileViewModeAction_Click"
            FontSize="18"
            Foreground="White"
            Tag="Details">
            <Button.Content>
              <Grid ColumnDefinitions="12,*" ColumnSpacing="8">
                <Ellipse
                  Width="7"
                  Height="7"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource HelloAccentBrush}"
                  IsVisible="{Binding IsDetailsView}" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Foreground="White"
                  Text="详细信息" />
              </Grid>
            </Button.Content>
          </Button>
          <Button
            Height="58"
            Padding="20,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="MobileViewModeAction_Click"
            FontSize="18"
            Foreground="White"
            Tag="LargeIcons">
            <Button.Content>
              <Grid ColumnDefinitions="12,*" ColumnSpacing="8">
                <Ellipse
                  Width="7"
                  Height="7"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource HelloAccentBrush}"
                  IsVisible="{Binding IsLargeIconView}" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Foreground="White"
                  Text="大图标" />
              </Grid>
            </Button.Content>
          </Button>
          <Button
            Height="58"
            Padding="20,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="MobileViewModeAction_Click"
            FontSize="18"
            Foreground="White"
            Tag="ExtraLargeIcons">
            <Button.Content>
              <Grid ColumnDefinitions="12,*" ColumnSpacing="8">
                <Ellipse
                  Width="7"
                  Height="7"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource HelloAccentBrush}"
                  IsVisible="{Binding IsExtraLargeIconView}" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Foreground="White"
                  Text="超大图标" />
              </Grid>
            </Button.Content>
          </Button>
        </StackPanel>
      </Border>
    </Grid>

    <!--  Mobile sort action panel. It intentionally mirrors the image-preview long-press surface.  -->
    <Grid
      x:Name="MobileSortActionsOverlay"
      Background="#72000000"
      IsVisible="False"
      PointerPressed="MobileSortActionsBackdrop_PointerPressed"
      ZIndex="3200">
      <Border
        MaxWidth="420"
        Margin="28"
        Padding="0,8"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center"
        Background="#F0444444"
        BorderBrush="#28FFFFFF"
        BorderThickness="1"
        CornerRadius="8"
        PointerPressed="OverlayContent_PointerPressed">
        <StackPanel HorizontalAlignment="Stretch">
          <Button
            Height="58"
            Padding="20,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="MobileSortAction_Click"
            FontSize="18"
            Foreground="White"
            Tag="Inherit:Default">
            <Button.Content>
              <Grid ColumnDefinitions="12,*" ColumnSpacing="8">
                <Ellipse
                  Width="7"
                  Height="7"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource HelloAccentBrush}"
                  IsVisible="{Binding IsSystemDefaultSort}" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Foreground="White"
                  Text="系统默认" />
              </Grid>
            </Button.Content>
          </Button>
          <Button
            Height="58"
            Padding="20,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="MobileSortAction_Click"
            FontSize="18"
            Foreground="White"
            Tag="Name:Ascending">
            <Button.Content>
              <Grid ColumnDefinitions="12,*" ColumnSpacing="8">
                <Ellipse
                  Width="7"
                  Height="7"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource HelloAccentBrush}"
                  IsVisible="{Binding IsNameAscendingSort}" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Foreground="White"
                  Text="名称 · 升序" />
              </Grid>
            </Button.Content>
          </Button>
          <Button
            Height="58"
            Padding="20,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="MobileSortAction_Click"
            FontSize="18"
            Foreground="White"
            Tag="Name:Descending">
            <Button.Content>
              <Grid ColumnDefinitions="12,*" ColumnSpacing="8">
                <Ellipse
                  Width="7"
                  Height="7"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource HelloAccentBrush}"
                  IsVisible="{Binding IsNameDescendingSort}" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Foreground="White"
                  Text="名称 · 降序" />
              </Grid>
            </Button.Content>
          </Button>
          <Button
            Height="58"
            Padding="20,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="MobileSortAction_Click"
            FontSize="18"
            Foreground="White"
            Tag="Modified:Ascending">
            <Button.Content>
              <Grid ColumnDefinitions="12,*" ColumnSpacing="8">
                <Ellipse
                  Width="7"
                  Height="7"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource HelloAccentBrush}"
                  IsVisible="{Binding IsModifiedAscendingSort}" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Foreground="White"
                  Text="日期 · 升序" />
              </Grid>
            </Button.Content>
          </Button>
          <Button
            Height="58"
            Padding="20,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="MobileSortAction_Click"
            FontSize="18"
            Foreground="White"
            Tag="Modified:Descending">
            <Button.Content>
              <Grid ColumnDefinitions="12,*" ColumnSpacing="8">
                <Ellipse
                  Width="7"
                  Height="7"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource HelloAccentBrush}"
                  IsVisible="{Binding IsModifiedDescendingSort}" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Foreground="White"
                  Text="日期 · 降序" />
              </Grid>
            </Button.Content>
          </Button>
          <Button
            Height="58"
            Padding="20,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="MobileSortAction_Click"
            FontSize="18"
            Foreground="White"
            Tag="Size:Ascending">
            <Button.Content>
              <Grid ColumnDefinitions="12,*" ColumnSpacing="8">
                <Ellipse
                  Width="7"
                  Height="7"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource HelloAccentBrush}"
                  IsVisible="{Binding IsSizeAscendingSort}" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Foreground="White"
                  Text="大小 · 升序" />
              </Grid>
            </Button.Content>
          </Button>
          <Button
            Height="58"
            Padding="20,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="MobileSortAction_Click"
            FontSize="18"
            Foreground="White"
            Tag="Size:Descending">
            <Button.Content>
              <Grid ColumnDefinitions="12,*" ColumnSpacing="8">
                <Ellipse
                  Width="7"
                  Height="7"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource HelloAccentBrush}"
                  IsVisible="{Binding IsSizeDescendingSort}" />
                <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Foreground="White"
                  Text="大小 · 降序" />
              </Grid>
            </Button.Content>
          </Button>
        </StackPanel>
      </Border>
    </Grid>

    <!--
      Mobile preview action panel. This intentionally uses an in-page overlay instead of
      ContextMenu so Android Back can dismiss it before the preview itself and so image
      long-press can open the exact same surface.
    -->
    <Grid
      x:Name="MobilePreviewActionsOverlay"
      Background="#72000000"
      IsVisible="False"
      PointerPressed="MobilePreviewActionsBackdrop_PointerPressed"
      ZIndex="3200">
      <Border
        MaxWidth="420"
        Margin="28"
        Padding="0,8"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center"
        Background="#F0444444"
        BorderBrush="#28FFFFFF"
        BorderThickness="1"
        CornerRadius="8"
        PointerPressed="OverlayContent_PointerPressed">
        <StackPanel HorizontalAlignment="Stretch">
          <Button
            Height="58"
            Padding="20,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="PreviewSlideshow_Click"
            Content="{Binding SlideshowText}"
            FontSize="18"
            Foreground="White"
            IsVisible="{Binding IsImagePreview}" />
          <Button
            Height="58"
            Padding="20,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="PreviewDownload_Click"
            Content="下载"
            FontSize="18"
            Foreground="White" />
          <Button
            Height="58"
            Padding="20,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="PreviewCache_Click"
            Content="缓存"
            FontSize="18"
            Foreground="White" />
          <Button
            Height="58"
            Padding="20,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="PreviewShare_Click"
            Content="分享"
            FontSize="18"
            Foreground="White" />
          <Button
            Height="58"
            Padding="20,0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="PreviewDetails_Click"
            Content="详细信息"
            FontSize="18"
            Foreground="White" />
        </StackPanel>
      </Border>
    </Grid>

    <!--  HelloV-style acrylic slide-over: duplicated wallpaper + blur + translucent tint.  -->
    <Grid
      x:Name="SettingsOverlay"
      IsVisible="{Binding IsSettingsPanelVisible}"
      ZIndex="1800">
      <Border Background="#01000000" PointerPressed="SettingsBackdrop_PointerPressed" />
      <Border
        x:Name="SettingsPanelHost"
        MinWidth="{OnFormFactor Desktop=430,
                                Mobile=0}"
        MaxWidth="{OnFormFactor Desktop=430,
                                Mobile=10000}"
        HorizontalAlignment="{OnFormFactor Desktop=Right,
                                           Mobile=Stretch}"
        VerticalAlignment="Stretch"
        Background="Transparent"
        BorderBrush="#45FFFFFF"
        BorderThickness="{OnFormFactor Desktop='1,0,0,0',
                                       Mobile='0'}"
        BoxShadow="-14 0 36 0 #52000000"
        ClipToBounds="True"
        PointerPressed="OverlayContent_PointerPressed">
        <Border.RenderTransform>
          <TranslateTransform X="430" />
        </Border.RenderTransform>
        <Grid ClipToBounds="True">
          <!--  Desktop keeps the slide-over acrylic treatment.  -->
          <Grid IsVisible="{OnFormFactor Desktop=True, Mobile=False}">
            <Border
              x:Name="SettingsAcrylicBase"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              Opacity="0.72" />
            <Image
              x:Name="SettingsAcrylicBackgroundImage"
              IsVisible="False"
              Opacity="0.78"
              Stretch="UniformToFill">
              <Image.Effect>
                <BlurEffect Radius="22" />
              </Image.Effect>
            </Image>
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" Opacity="0.42" />
            <Border IsHitTestVisible="False" Opacity="0.28">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Offset="0" Color="#70FFFFFF" />
                  <GradientStop Offset="0.55" Color="#08000000" />
                  <GradientStop Offset="1" Color="#30000000" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
          </Grid>

          <!--  Mobile settings uses exactly the same app background stack as the file/profile/transfer pages.  -->
          <Grid IsVisible="{OnFormFactor Desktop=False, Mobile=True}">
            <Border x:Name="MobileSettingsBackgroundColor" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Image
              x:Name="MobileSettingsBackgroundImage"
              IsVisible="False"
              Stretch="UniformToFill" />
            <Border
              x:Name="MobileSettingsBackgroundScrim"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              Opacity="0.30" />
          </Grid>

          <Grid Margin="{OnFormFactor Desktop='22,26,22,20', Mobile='16,18,16,14'}" RowDefinitions="Auto,*">
            <Grid
              Grid.Row="0"
              Margin="0,0,0,14"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock
                  FontSize="25"
                  FontWeight="SemiBold"
                  Text="设置" />
                <TextBlock Classes="caption" Text="Hello1Drive" />
              </StackPanel>
              <Button
                Grid.Column="1"
                Classes="icon iconCloseGlyph"
                Click="CloseSettingsButton_Click"
                Content="×"
                IsVisible="{OnFormFactor Desktop=True,
                                         Mobile=False}" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="{OnFormFactor Desktop=Auto, Mobile=Hidden}">
              <StackPanel Spacing="16">
                <StackPanel Spacing="7">
                  <TextBlock FontWeight="SemiBold" Text="主题" />
                  <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeText, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Spacing="7">
                  <TextBlock FontWeight="SemiBold" Text="窗体背景" />
                  <ComboBox ItemsSource="{Binding BackgroundModeOptions}" SelectedItem="{Binding SelectedBackgroundModeText, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsBackgroundColorMode}" Spacing="7">
                  <TextBlock Classes="caption" Text="背景颜色" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox
                      Grid.Column="0"
                      PlaceholderText="#FD6F71"
                      Text="{Binding BackgroundColorText, Mode=TwoWay}" />
                    <Button
                      Grid.Column="1"
                      Width="40"
                      Height="34"
                      MinWidth="40"
                      MinHeight="34"
                      Padding="7"
                      IsVisible="{OnFormFactor Desktop=True,
                                               Mobile=False}"
                      ToolTip.Tip="选择颜色">
                      <Border
                        Width="20"
                        Height="20"
                        Background="{Binding BackgroundColorPreviewBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        BorderThickness="1"
                        CornerRadius="4" />
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                          <Border
                            MinWidth="320"
                            MaxWidth="380"
                            Padding="10">
                            <ColorView
                              IsAccentColorsVisible="False"
                              IsAlphaEnabled="False"
                              IsAlphaVisible="False"
                              IsColorComponentsVisible="True"
                              IsColorPaletteVisible="True"
                              IsColorPreviewVisible="True"
                              IsColorSpectrumVisible="True"
                              IsHexInputVisible="True"
                              Color="{Binding BackgroundPickerColor, Mode=TwoWay}" />
                          </Border>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                  <Border
                    Padding="8"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    IsVisible="{OnFormFactor Desktop=False,
                                             Mobile=True}">
                    <ColorView
                      IsAccentColorsVisible="False"
                      IsAlphaEnabled="False"
                      IsAlphaVisible="False"
                      IsColorComponentsVisible="True"
                      IsColorPaletteVisible="True"
                      IsColorPreviewVisible="True"
                      IsColorSpectrumVisible="True"
                      IsHexInputVisible="True"
                      Color="{Binding BackgroundPickerColor, Mode=TwoWay}" />
                  </Border>
                  <TextBlock Classes="caption" Text="{OnFormFactor Desktop='可直接输入 HEX，也可以点击右侧色块打开调色盘。', Mobile='可直接输入 HEX，或使用下方调色盘。'}" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsBackgroundUrlMode}" Spacing="7">
                  <TextBlock Classes="caption" Text="图片 URL" />
                  <TextBox PlaceholderText="https://example.com/background.jpg" Text="{Binding BackgroundUrl, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsBackgroundLocalImageMode}" Spacing="7">
                  <TextBlock Text="{Binding LocalImageDisplayName, FallbackValue='尚未选择图片'}" TextWrapping="Wrap" />
                  <Button
                    HorizontalAlignment="Stretch"
                    Click="PickLocalImageButton_Click"
                    Content="选择本地图片" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsBackgroundLocalFolderMode}" Spacing="7">
                  <TextBlock Text="{Binding LocalFolderDisplayName, FallbackValue='尚未选择文件夹'}" TextWrapping="Wrap" />
                  <Button
                    HorizontalAlignment="Stretch"
                    Click="PickLocalFolderButton_Click"
                    Content="选择本地文件夹" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsBackgroundOneDriveFolderMode}" Spacing="7">
                  <TextBlock Text="{Binding OneDriveBackgroundFolderName, FallbackValue='尚未选择 OneDrive 文件夹'}" TextWrapping="Wrap" />
                  <Button
                    HorizontalAlignment="Stretch"
                    Click="UseCurrentOneDriveFolderButton_Click"
                    Content="使用当前 OneDrive 文件夹" />
                  <TextBlock
                    Classes="caption"
                    Text="先在主界面进入目标目录，再点击此按钮。"
                    TextWrapping="Wrap" />
                </StackPanel>

                <Grid
                  ColumnDefinitions="*,120"
                  ColumnSpacing="10"
                  IsVisible="{Binding IsBackgroundFolderMode}">
                  <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="图片切换时间" />
                    <TextBlock Classes="caption" Text="单位：分钟" />
                  </StackPanel>
                  <NumericUpDown
                    Grid.Column="1"
                    Increment="0.5"
                    Maximum="1440"
                    Minimum="0.1"
                    Value="{Binding BackgroundIntervalMinutes, Mode=TwoWay}" />
                </Grid>

                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="亚克力磨砂程度" />
                      <TextBlock Classes="caption" Text="应用背景与设置面板的磨砂强度（默认 50%）" />
                    </StackPanel>
                    <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Classes="caption"
                      Text="{Binding AcrylicBlurText}" />
                  </Grid>
                  <Slider
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding AcrylicBlurPercent, Mode=TwoWay}" />
                </StackPanel>

                <Border Height="1" Background="#28FFFFFF" />
                <TextBlock FontWeight="SemiBold" Text="浏览与界面" />
                <CheckBox Content="记住退出时所在目录" IsChecked="{Binding RememberLastFolder, Mode=TwoWay}" />
                <CheckBox Content="显示悬浮上传按钮" IsChecked="{Binding ShowFloatingUploadButton, Mode=TwoWay}" />
                <CheckBox Content="显示工具栏" IsChecked="{Binding ShowToolbar, Mode=TwoWay}" />
                <CheckBox Content="文件项背景透明" IsChecked="{Binding TransparentFileItemBackground, Mode=TwoWay}" />
                <CheckBox Content="删除文件/文件夹前确认" IsChecked="{Binding ConfirmBeforeDelete, Mode=TwoWay}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="使用内置查看器" />
                    <TextBlock
                      Classes="caption"
                      Text="关闭后，打开文件会先缓存，再交给系统默认应用。"
                      TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsChecked="{Binding UseBuiltInViewer, Mode=TwoWay}"
                    OffContent="关闭"
                    OnContent="打开" />
                </Grid>

                <Grid
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="10"
                  IsVisible="{Binding IsStartWithWindowsSupported}">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="开机启动" />
                    <TextBlock
                      Classes="caption"
                      Text="登录 Windows 后自动启动 Hello1Drive，并直接在系统托盘运行。"
                      TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                    OffContent="关闭"
                    OnContent="打开" />
                </Grid>

                <Grid ColumnDefinitions="*,170" ColumnSpacing="10">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="默认排序方式" />
                    <TextBlock
                      Classes="caption"
                      Text="修改后会清除所有文件夹现有的独立排序；之后仍可在任意文件夹里单独设置排序。"
                      TextWrapping="Wrap" />
                  </StackPanel>
                  <ComboBox
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding DefaultSortOptions}"
                    SelectedItem="{Binding SelectedDefaultSortText, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnDefinitions="*,120" ColumnSpacing="10">
                  <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="幻灯片切换时间" />
                    <TextBlock Classes="caption" Text="单位：秒" />
                  </StackPanel>
                  <NumericUpDown
                    Grid.Column="1"
                    Increment="1"
                    Maximum="3600"
                    Minimum="1"
                    Value="{Binding SlideshowIntervalSeconds, Mode=TwoWay}" />
                </Grid>

                <Border Height="1" Background="#28FFFFFF" />
                <TextBlock FontWeight="SemiBold" Text="传输限速" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBlock VerticalAlignment="Center" Text="限制下载速率" />
                  <ToggleSwitch
                    Grid.Column="1"
                    IsChecked="{Binding LimitDownloadSpeed, Mode=TwoWay}"
                    OffContent="关闭"
                    OnContent="打开" />
                </Grid>
                <Grid
                  ColumnDefinitions="Auto,150,Auto"
                  ColumnSpacing="8"
                  IsEnabled="{Binding LimitDownloadSpeed}">
                  <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="caption"
                    Text="限制为" />
                  <NumericUpDown
                    Grid.Column="1"
                    Increment="64"
                    Maximum="1048576"
                    Minimum="1"
                    Value="{Binding DownloadSpeedLimitKBps, Mode=TwoWay}" />
                  <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Classes="caption"
                    Text="KB/s" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBlock VerticalAlignment="Center" Text="限制上传速率" />
                  <ToggleSwitch
                    Grid.Column="1"
                    IsChecked="{Binding LimitUploadSpeed, Mode=TwoWay}"
                    OffContent="关闭"
                    OnContent="打开" />
                </Grid>
                <Grid
                  ColumnDefinitions="Auto,150,Auto"
                  ColumnSpacing="8"
                  IsEnabled="{Binding LimitUploadSpeed}">
                  <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="caption"
                    Text="限制为" />
                  <NumericUpDown
                    Grid.Column="1"
                    Increment="64"
                    Maximum="1048576"
                    Minimum="1"
                    Value="{Binding UploadSpeedLimitKBps, Mode=TwoWay}" />
                  <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Classes="caption"
                    Text="KB/s" />
                </Grid>

                <Button
                  HorizontalAlignment="Stretch"
                  Click="DownloadAllFilesButton_Click"
                  Content="下载所有 OneDrive 文件" />

                <Border Height="1" Background="#28FFFFFF" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock FontWeight="SemiBold" Text="缓存" />
                    <TextBlock
                      Classes="caption"
                      Text="{Binding CacheStatusText}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                  <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Command="{Binding ClearCacheCommand}"
                    Content="清除缓存" />
                </Grid>

                <TextBlock
                  Classes="caption"
                  Text="设置修改后会自动保存并立即生效。"
                  TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!--  Error banner  -->
    <Border
      Margin="14"
      Padding="12"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Top"
      Background="#C93B3B"
      CornerRadius="8"
      IsVisible="{Binding HasError}"
      ZIndex="2200">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock
          Foreground="White"
          Text="{Binding ErrorMessage}"
          TextWrapping="Wrap" />
        <Button
          Grid.Column="1"
          Classes="iconCloseGlyph"
          Command="{Binding CloseErrorCommand}"
          Content="×" />
      </Grid>
    </Border>

    <!--  Download-all confirmation stays a compact dialog on mobile instead of becoming a page.  -->
    <Grid
      x:Name="DownloadAllConfirmOverlay"
      Background="{DynamicResource HelloOverlayBrush}"
      IsVisible="False"
      ZIndex="3050">
      <Border
        Width="{OnFormFactor Desktop=380,
                             Mobile=300}"
        MaxWidth="420"
        Margin="24"
        Padding="22"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
        BorderThickness="1"
        BoxShadow="0 10 34 0 #52000000"
        CornerRadius="14">
        <StackPanel Spacing="16">
          <StackPanel Spacing="6">
            <TextBlock
              FontSize="20"
              FontWeight="SemiBold"
              Text="下载所有 OneDrive 文件"
              TextWrapping="Wrap" />
            <TextBlock
              Classes="caption"
              Text="此操作会递归下载 OneDrive 中的全部文件和文件夹，可能消耗大量网络流量和本地磁盘空间。是否继续？"
              TextWrapping="Wrap" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button
              Classes="sectionAction"
              Click="CancelDownloadAllButton_Click"
              Content="取消" />
            <Button
              Grid.Column="1"
              Classes="coral sectionAction"
              Click="ConfirmDownloadAllButton_Click"
              Content="继续" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!--  Unified transparent loading overlay.  -->
    <Grid
      Background="Transparent"
      IsHitTestVisible="True"
      IsVisible="{Binding IsBusy}"
      ZIndex="2100">
      <controls:LoadingIndicator HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>

    <!--  HelloCrab-style prompt overlay  -->
    <Grid
      Background="{DynamicResource HelloOverlayBrush}"
      IsVisible="{Binding IsPromptVisible}"
      ZIndex="3000">
      <Border
        MinWidth="{OnFormFactor Desktop=420,
                                Mobile=0}"
        MaxWidth="{OnFormFactor Desktop=420,
                                Mobile=10000}"
        MaxHeight="{OnFormFactor Desktop=720,
                                 Mobile=10000}"
        Margin="{OnFormFactor Desktop='20',
                              Mobile='0'}"
        Padding="{OnFormFactor Desktop='22',
                               Mobile='20,24'}"
        HorizontalAlignment="{OnFormFactor Desktop=Center,
                                           Mobile=Stretch}"
        VerticalAlignment="{OnFormFactor Desktop=Center,
                                         Mobile=Stretch}"
        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
        BorderThickness="{OnFormFactor Desktop='1',
                                       Mobile='0'}"
        CornerRadius="{OnFormFactor Desktop=10,
                                    Mobile=0}">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Button
              Grid.Column="0"
              VerticalAlignment="Top"
              Classes="icon"
              Command="{Binding CancelPromptCommand}"
              Content="←"
              IsVisible="{OnFormFactor Desktop=False,
                                       Mobile=True}"
              ToolTip.Tip="返回" />
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="{Binding PromptTitle}" />
              <TextBlock
                Classes="caption"
                Text="{Binding PromptMessage}"
                TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <TextBox IsVisible="{Binding IsPromptInputVisible}" Text="{Binding PromptText, Mode=TwoWay}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button
              Classes="sectionAction"
              Command="{Binding CancelPromptCommand}"
              Content="取消" />
            <Button
              Grid.Column="1"
              Classes="coral sectionAction"
              Command="{Binding ConfirmPromptCommand}"
              Content="确定" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!--  HelloCrab-style logout confirmation  -->
    <Grid
      Background="{DynamicResource HelloOverlayBrush}"
      IsVisible="{Binding IsLogoutConfirmVisible}"
      ZIndex="3100">
      <Border
        MinWidth="{OnFormFactor Desktop=420,
                                Mobile=0}"
        MaxWidth="{OnFormFactor Desktop=420,
                                Mobile=10000}"
        MaxHeight="{OnFormFactor Desktop=720,
                                 Mobile=10000}"
        Margin="{OnFormFactor Desktop='20',
                              Mobile='0'}"
        Padding="{OnFormFactor Desktop='22',
                               Mobile='20,24'}"
        HorizontalAlignment="{OnFormFactor Desktop=Center,
                                           Mobile=Stretch}"
        VerticalAlignment="{OnFormFactor Desktop=Center,
                                         Mobile=Stretch}"
        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
        BorderThickness="{OnFormFactor Desktop='1',
                                       Mobile='0'}"
        CornerRadius="{OnFormFactor Desktop=10,
                                    Mobile=0}">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Button
              Grid.Column="0"
              VerticalAlignment="Top"
              Classes="icon"
              Command="{Binding CancelLogoutCommand}"
              Content="←"
              IsVisible="{OnFormFactor Desktop=False,
                                       Mobile=True}"
              ToolTip.Tip="返回" />
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="退出登录" />
              <TextBlock
                Classes="caption"
                Text="确定退出当前 Microsoft 账户吗？本地设置和传输历史不会删除。"
                TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button
              Classes="sectionAction"
              Command="{Binding CancelLogoutCommand}"
              Content="取消" />
            <Button
              Grid.Column="1"
              Classes="coral sectionAction"
              Command="{Binding ConfirmLogoutCommand}"
              Content="退出登录" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!--  App close confirmation is a real compact dialog on every platform.  -->
    <Grid
      Background="{DynamicResource HelloOverlayBrush}"
      IsVisible="{Binding IsCloseConfirmVisible}"
      ZIndex="3200">
      <Border
        Width="{OnFormFactor Desktop=380,
                             Mobile=300}"
        MaxWidth="420"
        Margin="24"
        Padding="22"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
        BorderThickness="1"
        BoxShadow="0 10 34 0 #52000000"
        CornerRadius="14">
        <StackPanel Spacing="16">
          <StackPanel Spacing="6">
            <TextBlock
              FontSize="20"
              FontWeight="SemiBold"
              Text="关闭 Hello1Drive" />
            <TextBlock
              Classes="caption"
              Text="{Binding CloseConfirmationMessage}"
              TextWrapping="Wrap" />
          </StackPanel>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button
              Classes="sectionAction"
              Click="CancelAppCloseButton_Click"
              Content="取消" />
            <Button
              Grid.Column="1"
              Classes="coral sectionAction"
              Click="ConfirmAppCloseButton_Click"
              Content="关闭" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
