              <Grid IsVisible="{Binding IsGenericFile}">
                <Border
                  Width="82"
                  Height="96"
                  Background="#F8FAFC"
                  BorderBrush="#C7D2E4"
                  BorderThickness="1.5"
                  CornerRadius="12" />
                <Border
                  Width="82"
                  Height="24"
                  VerticalAlignment="Bottom"
                  Background="#60A5FA"
                  CornerRadius="0,0,12,12" />
                <TextBlock
                  Margin="0,0,0,6"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  FontSize="9"
                  FontWeight="SemiBold"
                  Foreground="White"
                  Text="{Binding FileBadgeText}" />
              </Grid>
            </Grid>
            <Border
              Background="#16000000"
              ClipToBounds="True"
              CornerRadius="8"
              IsVisible="{Binding HasThumbnailImage}">
              <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" />
            </Border>
            <Border
              Width="24"
              Height="24"
              Margin="0,0,5,5"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Background="#B0000000"
              CornerRadius="12"
              IsVisible="{Binding ShowVideoThumbnailBadge}">
              <TextBlock
                Margin="2,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="White"
                Text="▶" />
            </Border>
          </Grid>
          <TextBlock
            Grid.Row="1"
            MaxLines="2"
            Text="{Binding Name}"
            TextAlignment="Center"
            TextTrimming="CharacterEllipsis" />
          <TextBlock
            Grid.Row="2"
            HorizontalAlignment="Center"
            Classes="caption"
            Text="{Binding SizeDisplay}" />
        </Grid>
      </Border>
    </DataTemplate>
