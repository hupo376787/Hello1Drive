<UserControl
  x:Class="Hello1Drive.Views.MainView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:Hello1Drive.Controls"
  xmlns:models="using:Hello1Drive.Models"
  xmlns:vm="using:Hello1Drive.ViewModels"
  x:CompileBindings="True"
  x:DataType="vm:MainViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="DetailsFileItemTemplate" x:DataType="models:DriveItemModel">
      <Grid
        Height="46"
        Margin="0"
        Classes="fileItemSurface"
        ColumnDefinitions="{OnFormFactor Desktop='42,*,150,130,190',
                                         Mobile='38,*,90'}"
        ColumnSpacing="6"
        ContextRequested="FileItem_ContextRequested"
        DoubleTapped="FileItem_DoubleTapped"
        Holding="FileItem_Holding"
        InputElement.IsHoldingEnabled="True"
        PointerPressed="FileItem_PointerPressed"
        Tapped="FileItem_Tapped">
        <Border
          Grid.ColumnSpan="5"
          Background="{DynamicResource HelloExplorerSelectionBrush}"
          CornerRadius="5"
          IsHitTestVisible="False"
          IsVisible="{Binding IsMobileSelected}" />
        <Grid.ContextMenu>
          <ContextMenu>
            <MenuItem Click="FileContext_Open_Click" Header="打开">
              <MenuItem.Icon>
                <Path Classes="menuIcon iconOpen" Data="M2,7 C4.6,3.8 9.4,3.8 12,7 C9.4,10.2 4.6,10.2 2,7 Z M7,5.3 A1.7,1.7 0 1 1 7,8.7 A1.7,1.7 0 0 1 7,5.3 Z" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Click="FileContext_Download_Click" Header="下载">
              <MenuItem.Icon>
                <Path Classes="menuIcon iconDownload" Data="M7,1.5 V9 M4.5,6.5 L7,9 L9.5,6.5 M2,11.5 H12" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="FileContext_Cache_Click" Header="缓存">
              <MenuItem.Icon>
                <Path Classes="menuIcon iconCache" Data="M4,3 H10.5 A2,2 0 0 1 12.5,5 V10.5 A2,2 0 0 1 10.5,12.5 H3.5 A2,2 0 0 1 1.5,10.5 V5 A2,2 0 0 1 3.5,3 M4.5,6.2 H9.5 M4.5,9.2 H8" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="FileContext_Rename_Click" Header="重命名">
              <MenuItem.Icon>
                <Path Classes="menuIcon iconRename" Data="M2,11.5 L2.7,8.8 L9.7,1.8 L12.2,4.3 L5.2,11.3 Z M8.5,3 L11,5.5" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="FileContext_Delete_Click" Header="删除">
              <MenuItem.Icon>
                <Path Classes="menuIcon iconDanger" Data="M3,4 H11 M5,4 V2.5 H9 V4 M4,5.5 L4.6,12 H9.4 L10,5.5 M6,6.7 V10 M8,6.7 V10" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
              Click="FileContext_OpenWeb_Click"
              Header="在 OneDrive 网页中打开"
              IsVisible="{Binding HasWebUrl}">
              <MenuItem.Icon>
                <Path Classes="menuIcon iconWeb" Data="M5.5,2 H2.5 V11.5 H12 V8.5 M7.5,2 H12 V6.5 M12,2 L6,8" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Grid.ContextMenu>
        <Grid
          Grid.Column="0"
          Width="36"
          Height="36"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
          <Grid IsVisible="{Binding HasNoThumbnailImage}">
            <Viewbox
              Width="26"
              Height="26"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsVisible="{Binding IsFolder}"
              Stretch="Uniform">
              <Canvas Width="32" Height="26">
                <!--  Layered yellow folder matched to the supplied OneDrive folder artwork.  -->
                <Path Data="M0,7.5 C0,5.1 1.9,3.1 4.3,3.1 H9.7 C10.7,3.1 11.4,3.4 12.2,4 L15.2,6.3 C16.2,7.1 17.3,7.4 18.7,7.4 H29.5 C30.9,7.4 32,8.5 32,9.9 V22.3 C32,24.3 30.3,26 28.3,26 H3.7 C1.7,26 0,24.3 0,22.3 Z" Fill="#F7BC0F" />
                <Border
                  Canvas.Left="4.4"
                  Canvas.Top="8.8"
                  Width="24.5"
                  Height="12.6"
                  Background="#FFD28D"
                  CornerRadius="1.2" />
                <Border
                  Canvas.Left="3.2"
                  Canvas.Top="10.1"
                  Width="24.5"
                  Height="11.8"
                  Background="#FFF2D6"
                  CornerRadius="1.2" />
                <Border
                  Canvas.Left="0"
                  Canvas.Top="11.5"
                  Width="32"
                  Height="14.5"
                  Background="#FFD76B"
                  CornerRadius="2.1" />
                <Border
                  Canvas.Left="2"
                  Canvas.Top="12.2"
                  Width="28"
                  Height="1.2"
                  Background="#55FFE9B0"
                  CornerRadius="0.6" />
              </Canvas>
            </Viewbox>
            <Grid
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsVisible="{Binding IsAudio}">
              <Viewbox
                Width="30"
                Height="30"
                Stretch="Uniform">
                <Canvas Width="32" Height="32">
                  <Ellipse
                    Canvas.Left="2"
                    Canvas.Top="7"
                    Width="23"
                    Height="23"
                    Fill="#60A5FA"
                    Opacity="0.95" />
                  <Ellipse
                    Canvas.Left="7"
                    Canvas.Top="2"
                    Width="23"
                    Height="23"
                    Fill="#FB7185"
                    Opacity="0.94" />
                  <Path
                    Data="M13,9 V22 M13,9 L23,6.8 V18.5"
                    Fill="Transparent"
                    Stroke="White"
                    StrokeJoin="Round"
                    StrokeLineCap="Round"
                    StrokeThickness="2.2" />
                  <Ellipse
                    Canvas.Left="6.2"
                    Canvas.Top="19.3"
                    Width="7.4"
                    Height="5.8"
                    Fill="White" />
                  <Ellipse
                    Canvas.Left="16.2"
                    Canvas.Top="15.8"
                    Width="7.4"
                    Height="5.8"
                    Fill="White" />
                </Canvas>
              </Viewbox>
            </Grid>
            <Grid
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsVisible="{Binding IsImage}">
              <Viewbox
                Width="30"
                Height="30"
                Stretch="Uniform">
                <Canvas Width="32" Height="32">
                  <Border
                    Canvas.Left="2"
                    Canvas.Top="2"
                    Width="28"
                    Height="28"
                    Background="#EEF7FF"
                    BorderBrush="#8EC5FF"
                    BorderThickness="1.2"
                    CornerRadius="7" />
                  <Path
                    Data="M7,23 L12,16.5 L16,20 L20,15.5 L25,23"
                    Fill="Transparent"
                    Stroke="#3B82F6"
                    StrokeJoin="Round"
                    StrokeLineCap="Round"
                    StrokeThickness="1.8" />
                  <Ellipse
                    Canvas.Left="8"
                    Canvas.Top="8"
                    Width="5"
                    Height="5"
                    Fill="#FDBA74" />
                </Canvas>
              </Viewbox>
            </Grid>
            <Grid IsVisible="{Binding IsVideo}">
              <Border
                Width="28"
                Height="28"
                Background="#EEF2FF"
                BorderBrush="#A5B4FC"
                BorderThickness="1"
                CornerRadius="7" />
              <Border
                Width="16"
                Height="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#7C3AED"
                CornerRadius="8">
                <TextBlock
                  Margin="1,0,0,0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="8"
                  Foreground="White"
                  Text="▶" />
              </Border>
            </Grid>
            <Grid IsVisible="{Binding IsPdf}">
              <Border
                Width="26"
                Height="30"
                Background="#FFF5F5"
                BorderBrush="#F0A0A8"
                BorderThickness="1"
                CornerRadius="6" />
              <Border
                Width="26"
                Height="9"
                VerticalAlignment="Bottom"
                Background="#EF4444"
                CornerRadius="0,0,6,6" />
              <TextBlock
                Margin="0,0,0,1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontSize="5"
                FontWeight="SemiBold"
                Foreground="White"
                Text="PDF" />
            </Grid>
            <Grid IsVisible="{Binding IsWord}">
              <Border
                Width="26"
                Height="30"
                Background="#EFF6FF"
                BorderBrush="#93C5FD"
                BorderThickness="1"
                CornerRadius="6" />
              <Border
                Width="26"
                Height="9"
                VerticalAlignment="Bottom"
                Background="#2563EB"
                CornerRadius="0,0,6,6" />
              <TextBlock
                Margin="0,0,0,1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontSize="5"
                FontWeight="SemiBold"
                Foreground="White"
                Text="DOC" />
            </Grid>
            <Grid IsVisible="{Binding IsExcel}">
              <Border
                Width="26"
                Height="30"
                Background="#F0FDF4"
                BorderBrush="#86EFAC"
                BorderThickness="1"
                CornerRadius="6" />
              <Border
                Width="26"
                Height="9"
                VerticalAlignment="Bottom"
                Background="#16A34A"
                CornerRadius="0,0,6,6" />
              <TextBlock
                Margin="0,0,0,1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontSize="5"
                FontWeight="SemiBold"
                Foreground="White"
                Text="XLS" />
            </Grid>
            <Grid IsVisible="{Binding IsPowerPoint}">
              <Border
                Width="26"
                Height="30"
                Background="#FFF7ED"
                BorderBrush="#FDBA74"
                BorderThickness="1"
                CornerRadius="6" />
              <Border
                Width="26"
                Height="9"
                VerticalAlignment="Bottom"
                Background="#F97316"
                CornerRadius="0,0,6,6" />
              <TextBlock
                Margin="0,0,0,1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontSize="5"
                FontWeight="SemiBold"
                Foreground="White"
                Text="PPT" />
            </Grid>
            <Grid IsVisible="{Binding IsArchive}">
              <Border
                Width="26"
                Height="30"
                Background="#F5F3FF"
                BorderBrush="#C4B5FD"
                BorderThickness="1"
                CornerRadius="6" />
              <Border
                Width="26"
                Height="9"
                VerticalAlignment="Bottom"
                Background="#8B5CF6"
                CornerRadius="0,0,6,6" />
              <TextBlock
                Margin="0,0,0,1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontSize="5"
                FontWeight="SemiBold"
                Foreground="White"
                Text="ZIP" />
            </Grid>
            <Grid IsVisible="{Binding IsUrlShortcut}">
              <Border
                Width="26"
                Height="30"
                Background="#F0FDFA"
                BorderBrush="#5EEAD4"
                BorderThickness="1"
                CornerRadius="6" />
              <Border
                Width="26"
                Height="9"
                VerticalAlignment="Bottom"
                Background="#0EA5A4"
                CornerRadius="0,0,6,6" />
              <TextBlock
                Margin="0,0,0,1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontSize="5"
                FontWeight="SemiBold"
                Foreground="White"
                Text="URL" />
            </Grid>
            <Grid IsVisible="{Binding IsText}">
              <Border
                Width="26"
                Height="30"
                Background="#F8FAFC"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="6" />
              <Border
                Width="26"
                Height="9"
                VerticalAlignment="Bottom"
                Background="#64748B"
                CornerRadius="0,0,6,6" />
              <TextBlock
                Margin="0,0,0,1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontSize="5"
                FontWeight="SemiBold"
                Foreground="White"
                Text="TXT" />
            </Grid>
            <Grid IsVisible="{Binding IsGenericFile}">
              <Border
                Width="26"
                Height="30"
                Background="#F8FAFC"
                BorderBrush="#C7D2E4"
                BorderThickness="1"
                CornerRadius="6" />
              <Border
                Width="26"
                Height="9"
                VerticalAlignment="Bottom"
                Background="#60A5FA"
                CornerRadius="0,0,6,6" />
              <TextBlock
                Margin="0,0,0,1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontSize="5"
                FontWeight="SemiBold"
                Foreground="White"
                Text="{Binding FileBadgeText}" />
            </Grid>
          </Grid>
          <Border
            Background="#16000000"
            ClipToBounds="True"
            CornerRadius="5"
            IsVisible="{Binding HasThumbnailImage}">
            <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" />
          </Border>
          <Border
            Width="14"
            Height="14"
            Margin="0,0,1,1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#B0000000"
            CornerRadius="7"
            IsVisible="{Binding ShowVideoThumbnailBadge}">
            <TextBlock
              Margin="1,0,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="7"
              Foreground="White"
              Text="▶" />
          </Border>
        </Grid>
        <TextBlock
          Grid.Column="1"
          VerticalAlignment="Center"
          Text="{Binding Name}"
          TextTrimming="CharacterEllipsis" />
        <TextBlock
          Grid.Column="2"
          VerticalAlignment="Center"
          IsVisible="{OnFormFactor Desktop=True,
                                   Mobile=False}"
          Opacity="0.68"
          Text="{Binding TypeDisplay}"
          TextTrimming="CharacterEllipsis" />
        <TextBlock
          Grid.Column="{OnFormFactor Desktop=3,
                                     Mobile=2}"
          VerticalAlignment="Center"
          Opacity="0.68"
          Text="{Binding SizeDisplay}" />
        <TextBlock
          Grid.Column="4"
          VerticalAlignment="Center"
          IsVisible="{OnFormFactor Desktop=True,
                                   Mobile=False}"
          Opacity="0.68"
          Text="{Binding ModifiedDisplay}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MobileDetailsFileItemTemplate" x:DataType="models:VirtualDriveItemSlot">
      <Grid
        Height="46"
        Margin="0"
        Classes="fileItemSurface"
        ColumnDefinitions="42,*,76"
        ColumnSpacing="6"
        ContextRequested="FileItem_ContextRequested"
        PointerPressed="FileItem_PointerPressed"
        PointerReleased="FileItem_PointerReleased"
        Tapped="FileItem_Tapped">
        <Border
          Grid.ColumnSpan="3"
          Background="{DynamicResource HelloExplorerSelectionBrush}"
          CornerRadius="5"
          IsHitTestVisible="False"
          IsVisible="{Binding IsMobileSelected}" />
        <Border
          Grid.ColumnSpan="3"
          Margin="7,7,8,7"
          Background="#10000000"
          CornerRadius="6"
          IsHitTestVisible="False"
          IsVisible="{Binding IsPlaceholder}" />
        <Grid
          Grid.ColumnSpan="3"
          Width="24"
          Height="24"
          Margin="0,3,6,0"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          IsHitTestVisible="False"
          IsVisible="{Binding IsMobileSelectionMode}"
          ZIndex="20">
          <Ellipse
            Fill="#66000000"
            Stroke="White"
            StrokeThickness="1.8" />
          <Ellipse
            Fill="#2F80ED"
            IsVisible="{Binding IsMobileSelected}"
            Stroke="White"
            StrokeThickness="1.8" />
          <Path
            Data="M6.5,12.5 L10.2,16 L17.8,8.2"
            IsVisible="{Binding IsMobileSelected}"
            Stroke="White"
            StrokeJoin="Round"
            StrokeLineCap="Round"
            StrokeThickness="2.2" />
        </Grid>
        <Grid
          Grid.Column="0"
          Width="36"
          Height="36"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
          <Grid IsVisible="{Binding HasNoThumbnailImage}">
            <Viewbox
              Width="27"
              Height="27"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsVisible="{Binding IsFolder}"
              Stretch="Uniform">
              <Canvas Width="32" Height="26">
                <!--  Layered yellow folder matched to the supplied OneDrive folder artwork.  -->
                <Path Data="M0,7.5 C0,5.1 1.9,3.1 4.3,3.1 H9.7 C10.7,3.1 11.4,3.4 12.2,4 L15.2,6.3 C16.2,7.1 17.3,7.4 18.7,7.4 H29.5 C30.9,7.4 32,8.5 32,9.9 V22.3 C32,24.3 30.3,26 28.3,26 H3.7 C1.7,26 0,24.3 0,22.3 Z" Fill="#F7BC0F" />
                <Border
                  Canvas.Left="4.4"
                  Canvas.Top="8.8"
                  Width="24.5"
                  Height="12.6"
                  Background="#FFD28D"
                  CornerRadius="1.2" />
                <Border
                  Canvas.Left="3.2"
                  Canvas.Top="10.1"
                  Width="24.5"
                  Height="11.8"
                  Background="#FFF2D6"
                  CornerRadius="1.2" />
                <Border
                  Canvas.Left="0"
                  Canvas.Top="11.5"
                  Width="32"
                  Height="14.5"
                  Background="#FFD76B"
                  CornerRadius="2.1" />
                <Border
                  Canvas.Left="2"
                  Canvas.Top="12.2"
                  Width="28"
                  Height="1.2"
                  Background="#55FFE9B0"
                  CornerRadius="0.6" />
              </Canvas>
            </Viewbox>
            <Grid
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsVisible="{Binding ShowMobileFileBadge}">
              <Border
                Width="25"
                Height="30"
                Background="#F8FAFC"
                BorderBrush="#C7D2E4"
                BorderThickness="1"
                CornerRadius="5" />
              <Border
                Width="25"
                Height="9"
                VerticalAlignment="Bottom"
                Background="#64748B"
                CornerRadius="0,0,5,5" />
              <TextBlock
                Margin="0,0,0,1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontSize="5"
                FontWeight="SemiBold"
                Foreground="White"
                Text="{Binding FileBadgeText}" />
            </Grid>
            <Grid
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsVisible="{Binding IsImage}">
              <Viewbox
                Width="30"
                Height="30"
                Stretch="Uniform">
                <Canvas Width="32" Height="32">
                  <Border
                    Canvas.Left="2"
                    Canvas.Top="2"
                    Width="28"
                    Height="28"
                    Background="#EEF7FF"
                    BorderBrush="#8EC5FF"
                    BorderThickness="1.2"
                    CornerRadius="7" />
                  <Path
                    Data="M7,23 L12,16.5 L16,20 L20,15.5 L25,23"
                    Fill="Transparent"
                    Stroke="#3B82F6"
                    StrokeJoin="Round"
                    StrokeLineCap="Round"
                    StrokeThickness="1.8" />
                  <Ellipse
                    Canvas.Left="8"
                    Canvas.Top="8"
                    Width="5"
                    Height="5"
                    Fill="#FDBA74" />
                </Canvas>
              </Viewbox>
            </Grid>
          </Grid>
          <Border
            Background="#16000000"
            ClipToBounds="True"
            CornerRadius="5"
            IsVisible="{Binding HasThumbnailImage}">
            <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" />
          </Border>
          <Border
            Width="14"
            Height="14"
            Margin="0,0,1,1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#B0000000"
            CornerRadius="7"
            IsVisible="{Binding ShowVideoThumbnailBadge}">
            <TextBlock
              Margin="1,0,0,0"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="7"
              Foreground="White"
              Text="▶" />
          </Border>
        </Grid>
        <TextBlock
          Grid.Column="1"
          VerticalAlignment="Center"
          Text="{Binding Name}"
          TextTrimming="CharacterEllipsis" />
        <TextBlock
          Grid.Column="2"
          Margin="0,0,8,0"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Opacity="0.62"
          Text="{Binding SizeDisplay}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MobileLargeFileItemTemplate" x:DataType="models:VirtualDriveItemSlot">
      <Border
        Margin="0"
        Padding="6"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Classes="fileItemSurface"
        ClipToBounds="True"
        ContextRequested="FileItem_ContextRequested"
        CornerRadius="9"
        PointerPressed="FileItem_PointerPressed"
        PointerReleased="FileItem_PointerReleased"
        Tapped="FileItem_Tapped">
        <Grid RowDefinitions="*,Auto,Auto" RowSpacing="3">
          <Border
            Grid.RowSpan="3"
            Background="{DynamicResource HelloExplorerSelectionBrush}"
            CornerRadius="9"
            IsHitTestVisible="False"
            IsVisible="{Binding IsMobileSelected}" />
          <Border
            Grid.RowSpan="3"
            Margin="5"
            Background="#10000000"
            CornerRadius="9"
            IsHitTestVisible="False"
            IsVisible="{Binding IsPlaceholder}" />
          <Grid
            Grid.RowSpan="3"
            Width="24"
            Height="24"
            Margin="0,4,4,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            IsVisible="{Binding IsMobileSelectionMode}"
            ZIndex="20">
            <Ellipse
              Fill="#66000000"
              Stroke="White"
              StrokeThickness="1.8" />
            <Ellipse
              Fill="#2F80ED"
              IsVisible="{Binding IsMobileSelected}"
              Stroke="White"
              StrokeThickness="1.8" />
            <Path
              Data="M6.5,12.5 L10.2,16 L17.8,8.2"
              IsVisible="{Binding IsMobileSelected}"
              Stroke="White"
              StrokeJoin="Round"
              StrokeLineCap="Round"
              StrokeThickness="2.2" />
          </Grid>
          <Grid
            Grid.Row="0"
            Margin="2,2,2,4"
            ClipToBounds="True">
            <Grid IsVisible="{Binding HasNoThumbnailImage}">
              <Viewbox
                Width="72"
                Height="72"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsFolder}"
                Stretch="Uniform">
                <Canvas Width="32" Height="26">
                  <!--  Layered yellow folder matched to the supplied OneDrive folder artwork.  -->
                  <Path Data="M0,7.5 C0,5.1 1.9,3.1 4.3,3.1 H9.7 C10.7,3.1 11.4,3.4 12.2,4 L15.2,6.3 C16.2,7.1 17.3,7.4 18.7,7.4 H29.5 C30.9,7.4 32,8.5 32,9.9 V22.3 C32,24.3 30.3,26 28.3,26 H3.7 C1.7,26 0,24.3 0,22.3 Z" Fill="#F7BC0F" />
                  <Border
                    Canvas.Left="4.4"
                    Canvas.Top="8.8"
                    Width="24.5"
                    Height="12.6"
                    Background="#FFD28D"
                    CornerRadius="1.2" />
                  <Border
                    Canvas.Left="3.2"
                    Canvas.Top="10.1"
                    Width="24.5"
                    Height="11.8"
                    Background="#FFF2D6"
                    CornerRadius="1.2" />
                  <Border
                    Canvas.Left="0"
                    Canvas.Top="11.5"
                    Width="32"
                    Height="14.5"
                    Background="#FFD76B"
                    CornerRadius="2.1" />
                  <Border
                    Canvas.Left="2"
                    Canvas.Top="12.2"
                    Width="28"
                    Height="1.2"
                    Background="#55FFE9B0"
                    CornerRadius="0.6" />
                </Canvas>
              </Viewbox>
              <Viewbox
                Width="72"
                Height="86"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding ShowMobileFileBadge}"
                Stretch="Uniform">
                <Grid Width="58" Height="70">
                  <Border
                    Background="#F8FAFC"
                    BorderBrush="#C7D2E4"
                    BorderThickness="1.3"
                    CornerRadius="9" />
                  <Border
                    Height="19"
                    VerticalAlignment="Bottom"
                    Background="#64748B"
                    CornerRadius="0,0,9,9" />
                  <TextBlock
                    Margin="0,0,0,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    FontSize="8"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{Binding FileBadgeText}" />
                </Grid>
              </Viewbox>
              <Viewbox
                Width="78"
                Height="78"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsImage}"
                Stretch="Uniform">
                <Canvas Width="32" Height="32">
                  <Border
                    Canvas.Left="2"
                    Canvas.Top="2"
                    Width="28"
                    Height="28"
                    Background="#EEF7FF"
                    BorderBrush="#8EC5FF"
                    BorderThickness="1.2"
                    CornerRadius="7" />
                  <Path
                    Data="M7,23 L12,16.5 L16,20 L20,15.5 L25,23"
                    Fill="Transparent"
                    Stroke="#3B82F6"
                    StrokeJoin="Round"
                    StrokeLineCap="Round"
                    StrokeThickness="1.8" />
                  <Ellipse
                    Canvas.Left="8"
                    Canvas.Top="8"
                    Width="5"
                    Height="5"
                    Fill="#FDBA74" />
                </Canvas>
              </Viewbox>
            </Grid>
            <Border
              Background="#16000000"
              ClipToBounds="True"
              CornerRadius="7"
              IsVisible="{Binding HasThumbnailImage}">
              <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" />
            </Border>
            <Border
              Width="21"
              Height="21"
              Margin="0,0,3,3"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Background="#B0000000"
              CornerRadius="11"
              IsVisible="{Binding ShowVideoThumbnailBadge}">
              <TextBlock
                Margin="1,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="9"
                Foreground="White"
                Text="▶" />
            </Border>
          </Grid>
          <TextBlock
            Grid.Row="1"
            MaxLines="2"
            Text="{Binding Name}"
            TextAlignment="Center"
            TextTrimming="CharacterEllipsis" />
          <TextBlock
            Grid.Row="2"
            HorizontalAlignment="Center"
            Classes="caption"
            Text="{Binding SizeDisplay}" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="MobileExtraLargeFileItemTemplate" x:DataType="models:VirtualDriveItemSlot">
      <Border
        Margin="0"
        Padding="8"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Classes="fileItemSurface"
        ClipToBounds="True"
        ContextRequested="FileItem_ContextRequested"
        CornerRadius="11"
        PointerPressed="FileItem_PointerPressed"
        PointerReleased="FileItem_PointerReleased"
        Tapped="FileItem_Tapped">
        <Grid RowDefinitions="*,Auto,Auto" RowSpacing="4">
          <Border
            Grid.RowSpan="3"
            Background="{DynamicResource HelloExplorerSelectionBrush}"
            CornerRadius="11"
            IsHitTestVisible="False"
            IsVisible="{Binding IsMobileSelected}" />
          <Border
            Grid.RowSpan="3"
            Margin="6"
            Background="#10000000"
            CornerRadius="11"
            IsHitTestVisible="False"
            IsVisible="{Binding IsPlaceholder}" />
          <Grid
            Grid.RowSpan="3"
            Width="26"
            Height="26"
            Margin="0,5,5,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            IsVisible="{Binding IsMobileSelectionMode}"
            ZIndex="20">
            <Ellipse
              Fill="#66000000"
              Stroke="White"
              StrokeThickness="1.8" />
            <Ellipse
              Fill="#2F80ED"
              IsVisible="{Binding IsMobileSelected}"
              Stroke="White"
              StrokeThickness="1.8" />
            <Path
              Data="M7,13.5 L11,17.2 L19.2,8.8"
              IsVisible="{Binding IsMobileSelected}"
              Stroke="White"
              StrokeJoin="Round"
              StrokeLineCap="Round"
              StrokeThickness="2.3" />
          </Grid>
          <Grid
            Grid.Row="0"
            Margin="2,2,2,5"
            ClipToBounds="True">
            <Grid IsVisible="{Binding HasNoThumbnailImage}">
              <Viewbox
                Width="102"
                Height="102"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsFolder}"
                Stretch="Uniform">
                <Canvas Width="32" Height="26">
                  <!--  Layered yellow folder matched to the supplied OneDrive folder artwork.  -->
                  <Path Data="M0,7.5 C0,5.1 1.9,3.1 4.3,3.1 H9.7 C10.7,3.1 11.4,3.4 12.2,4 L15.2,6.3 C16.2,7.1 17.3,7.4 18.7,7.4 H29.5 C30.9,7.4 32,8.5 32,9.9 V22.3 C32,24.3 30.3,26 28.3,26 H3.7 C1.7,26 0,24.3 0,22.3 Z" Fill="#F7BC0F" />
                  <Border
                    Canvas.Left="4.4"
                    Canvas.Top="8.8"
                    Width="24.5"
                    Height="12.6"
                    Background="#FFD28D"
                    CornerRadius="1.2" />
                  <Border
                    Canvas.Left="3.2"
                    Canvas.Top="10.1"
                    Width="24.5"
                    Height="11.8"
                    Background="#FFF2D6"
                    CornerRadius="1.2" />
                  <Border
                    Canvas.Left="0"
                    Canvas.Top="11.5"
                    Width="32"
                    Height="14.5"
                    Background="#FFD76B"
                    CornerRadius="2.1" />
                  <Border
                    Canvas.Left="2"
                    Canvas.Top="12.2"
                    Width="28"
                    Height="1.2"
                    Background="#55FFE9B0"
                    CornerRadius="0.6" />
                </Canvas>
              </Viewbox>
              <Viewbox
                Width="104"
                Height="124"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding ShowMobileFileBadge}"
                Stretch="Uniform">
                <Grid Width="82" Height="98">
                  <Border
                    Background="#F8FAFC"
                    BorderBrush="#C7D2E4"
                    BorderThickness="1.5"
                    CornerRadius="12" />
                  <Border
                    Height="25"
                    VerticalAlignment="Bottom"
                    Background="#64748B"
                    CornerRadius="0,0,12,12" />
                  <TextBlock
                    Margin="0,0,0,7"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    FontSize="9"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{Binding FileBadgeText}" />
                </Grid>
              </Viewbox>
              <Viewbox
                Width="110"
                Height="110"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsImage}"
                Stretch="Uniform">
                <Canvas Width="32" Height="32">
                  <Border
                    Canvas.Left="2"
                    Canvas.Top="2"
                    Width="28"
                    Height="28"
                    Background="#EEF7FF"
                    BorderBrush="#8EC5FF"
                    BorderThickness="1.2"
                    CornerRadius="7" />
                  <Path
                    Data="M7,23 L12,16.5 L16,20 L20,15.5 L25,23"
                    Fill="Transparent"
                    Stroke="#3B82F6"
                    StrokeJoin="Round"
                    StrokeLineCap="Round"
                    StrokeThickness="1.8" />
                  <Ellipse
                    Canvas.Left="8"
                    Canvas.Top="8"
                    Width="5"
                    Height="5"
                    Fill="#FDBA74" />
                </Canvas>
              </Viewbox>
            </Grid>
            <Border
              Background="#16000000"
              ClipToBounds="True"
              CornerRadius="9"
              IsVisible="{Binding HasThumbnailImage}">
              <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" />
            </Border>
            <Border
              Width="24"
              Height="24"
              Margin="0,0,4,4"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Background="#B0000000"
              CornerRadius="12"
              IsVisible="{Binding ShowVideoThumbnailBadge}">
              <TextBlock
                Margin="2,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="White"
                Text="▶" />
            </Border>
          </Grid>
          <TextBlock
            Grid.Row="1"
            MaxLines="2"
            Text="{Binding Name}"
            TextAlignment="Center"
            TextTrimming="CharacterEllipsis" />
          <TextBlock
            Grid.Row="2"
            HorizontalAlignment="Center"
            Classes="caption"
            Text="{Binding SizeDisplay}" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="LargeFileItemTemplate" x:DataType="models:DriveItemModel">
      <Border
        Height="154"
        Margin="0"
        Padding="10"
        HorizontalAlignment="Stretch"
        Classes="fileItemSurface"
        ContextRequested="FileItem_ContextRequested"
        CornerRadius="10"
        DoubleTapped="FileItem_DoubleTapped"
        Holding="FileItem_Holding"
        InputElement.IsHoldingEnabled="True"
        PointerPressed="FileItem_PointerPressed"
        Tapped="FileItem_Tapped">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Click="FileContext_Open_Click" Header="打开">
              <MenuItem.Icon>
                <Path Classes="menuIcon iconOpen" Data="M2,7 C4.6,3.8 9.4,3.8 12,7 C9.4,10.2 4.6,10.2 2,7 Z M7,5.3 A1.7,1.7 0 1 1 7,8.7 A1.7,1.7 0 0 1 7,5.3 Z" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Click="FileContext_Download_Click" Header="下载">
              <MenuItem.Icon>
                <Path Classes="menuIcon iconDownload" Data="M7,1.5 V9 M4.5,6.5 L7,9 L9.5,6.5 M2,11.5 H12" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="FileContext_Cache_Click" Header="缓存">
              <MenuItem.Icon>
                <Path Classes="menuIcon iconCache" Data="M4,3 H10.5 A2,2 0 0 1 12.5,5 V10.5 A2,2 0 0 1 10.5,12.5 H3.5 A2,2 0 0 1 1.5,10.5 V5 A2,2 0 0 1 3.5,3 M4.5,6.2 H9.5 M4.5,9.2 H8" />
              </MenuItem.Icon>
