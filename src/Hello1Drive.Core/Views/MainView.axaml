              <Grid IsVisible="{Binding IsPowerPoint}">
                <Border
                  Width="82"
                  Height="96"
                  Background="#FFF7ED"
                  BorderBrush="#FDBA74"
                  BorderThickness="1.5"
                  CornerRadius="12" />
                <Border
                  Width="82"
                  Height="24"
                  VerticalAlignment="Bottom"
                  Background="#F97316"
                  CornerRadius="0,0,12,12" />
                <TextBlock
                  Margin="0,0,0,6"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  FontSize="9"
                  FontWeight="SemiBold"
                  Foreground="White"
                  Text="PPT" />
              </Grid>
              <Grid IsVisible="{Binding IsArchive}">
                <Border
                  Width="82"
                  Height="96"
                  Background="#F5F3FF"
                  BorderBrush="#C4B5FD"
                  BorderThickness="1.5"
                  CornerRadius="12" />
                <Border
                  Width="82"
                  Height="24"
                  VerticalAlignment="Bottom"
                  Background="#8B5CF6"
                  CornerRadius="0,0,12,12" />
                <TextBlock
                  Margin="0,0,0,6"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  FontSize="9"
                  FontWeight="SemiBold"
                  Foreground="White"
                  Text="ZIP" />
              </Grid>
              <Grid IsVisible="{Binding IsUrlShortcut}">
                <Border
                  Width="82"
                  Height="96"
                  Background="#F0FDFA"
                  BorderBrush="#5EEAD4"
                  BorderThickness="1.5"
                  CornerRadius="12" />
                <Border
                  Width="82"
                  Height="24"
                  VerticalAlignment="Bottom"
                  Background="#0EA5A4"
                  CornerRadius="0,0,12,12" />
                <TextBlock
                  Margin="0,0,0,6"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  FontSize="9"
                  FontWeight="SemiBold"
                  Foreground="White"
                  Text="URL" />
              </Grid>
              <Grid IsVisible="{Binding IsText}">
                <Border
                  Width="82"
                  Height="96"
                  Background="#F8FAFC"
                  BorderBrush="#CBD5E1"
                  BorderThickness="1.5"
                  CornerRadius="12" />
                <Border
                  Width="82"
                  Height="24"
                  VerticalAlignment="Bottom"
                  Background="#64748B"
                  CornerRadius="0,0,12,12" />
                <TextBlock
                  Margin="0,0,0,6"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  FontSize="9"
                  FontWeight="SemiBold"
                  Foreground="White"
                  Text="TXT" />
