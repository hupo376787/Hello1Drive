              <MenuItem.Icon>
                <Path Classes="menuIcon iconRename" Data="M2,11.5 L2.7,8.8 L9.7,1.8 L12.2,4.3 L5.2,11.3 Z M8.5,3 L11,5.5" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="FileContext_Delete_Click" Header="删除">
              <MenuItem.Icon>
                <Path Classes="menuIcon iconDanger" Data="M3,4 H11 M5,4 V2.5 H9 V4 M4,5.5 L4.6,12 H9.4 L10,5.5 M6,6.7 V10 M8,6.7 V10" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem
              Click="FileContext_OpenWeb_Click"
              Header="在 OneDrive 网页中打开"
              IsVisible="{Binding HasWebUrl}">
              <MenuItem.Icon>
                <Path Classes="menuIcon iconWeb" Data="M5.5,2 H2.5 V11.5 H12 V8.5 M7.5,2 H12 V6.5 M12,2 L6,8" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Border.ContextMenu>
        <Grid RowDefinitions="*,Auto,Auto" RowSpacing="4">
          <Border
            Grid.RowSpan="3"
            Background="{DynamicResource HelloExplorerSelectionBrush}"
            CornerRadius="10"
            IsHitTestVisible="False"
            IsVisible="{Binding IsMobileSelected}" />
          <Grid Grid.Row="0" Margin="1,1,1,8">
            <Grid IsVisible="{Binding HasNoThumbnailImage}">
              <Viewbox
                Width="82"
                Height="82"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsFolder}"
                Stretch="Uniform">
                <Canvas Width="32" Height="26">
                  <!--  Layered yellow folder matched to the supplied OneDrive folder artwork.  -->
                  <Path Data="M0,7.5 C0,5.1 1.9,3.1 4.3,3.1 H9.7 C10.7,3.1 11.4,3.4 12.2,4 L15.2,6.3 C16.2,7.1 17.3,7.4 18.7,7.4 H29.5 C30.9,7.4 32,8.5 32,9.9 V22.3 C32,24.3 30.3,26 28.3,26 H3.7 C1.7,26 0,24.3 0,22.3 Z" Fill="#F7BC0F" />
                  <Border
                    Canvas.Left="4.4"
                    Canvas.Top="8.8"
                    Width="24.5"
                    Height="12.6"
                    Background="#FFD28D"
                    CornerRadius="1.2" />
                  <Border
                    Canvas.Left="3.2"
                    Canvas.Top="10.1"
                    Width="24.5"
                    Height="11.8"
                    Background="#FFF2D6"
                    CornerRadius="1.2" />
                  <Border
                    Canvas.Left="0"
                    Canvas.Top="11.5"
                    Width="32"
                    Height="14.5"
                    Background="#FFD76B"
                    CornerRadius="2.1" />
                  <Border
                    Canvas.Left="2"
                    Canvas.Top="12.2"
                    Width="28"
                    Height="1.2"
                    Background="#55FFE9B0"
                    CornerRadius="0.6" />
                </Canvas>
              </Viewbox>
              <Grid
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsAudio}">
                <Viewbox
                  Width="82"
                  Height="82"
                  Stretch="Uniform">
                  <Canvas Width="32" Height="32">
                    <Ellipse
                      Canvas.Left="2"
                      Canvas.Top="7"
                      Width="23"
                      Height="23"
                      Fill="#60A5FA"
                      Opacity="0.95" />
                    <Ellipse
                      Canvas.Left="7"
                      Canvas.Top="2"
                      Width="23"
                      Height="23"
                      Fill="#FB7185"
                      Opacity="0.94" />
                    <Path
                      Data="M13,9 V22 M13,9 L23,6.8 V18.5"
                      Fill="Transparent"
                      Stroke="White"
                      StrokeJoin="Round"
                      StrokeLineCap="Round"
                      StrokeThickness="2.2" />
                    <Ellipse
                      Canvas.Left="6.2"
                      Canvas.Top="19.3"
                      Width="7.4"
                      Height="5.8"
                      Fill="White" />
                    <Ellipse
                      Canvas.Left="16.2"
                      Canvas.Top="15.8"
                      Width="7.4"
                      Height="5.8"
                      Fill="White" />
                  </Canvas>
                </Viewbox>
              </Grid>
              <Grid
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsImage}">
                <Viewbox
                  Width="82"
                  Height="82"
                  Stretch="Uniform">
                  <Canvas Width="32" Height="32">
                    <Border
                      Canvas.Left="2"
                      Canvas.Top="2"
                      Width="28"
                      Height="28"
                      Background="#EEF7FF"
                      BorderBrush="#8EC5FF"
                      BorderThickness="1.2"
                      CornerRadius="7" />
                    <Path
                      Data="M7,23 L12,16.5 L16,20 L20,15.5 L25,23"
                      Fill="Transparent"
                      Stroke="#3B82F6"
                      StrokeJoin="Round"
                      StrokeLineCap="Round"
                      StrokeThickness="1.8" />
                    <Ellipse
                      Canvas.Left="8"
                      Canvas.Top="8"
                      Width="5"
                      Height="5"
                      Fill="#FDBA74" />
                  </Canvas>
                </Viewbox>
              </Grid>
              <Grid IsVisible="{Binding IsVideo}">
                <Border
                  Width="90"
                  Height="90"
                  Background="#EEF2FF"
                  BorderBrush="#A5B4FC"
                  BorderThickness="1.5"
                  CornerRadius="14" />
                <Border
                  Width="44"
                  Height="44"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="#7C3AED"
                  CornerRadius="22">
                  <TextBlock
                    Margin="4,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="22"
                    Foreground="White"
                    Text="▶" />
                </Border>
              </Grid>
              <Grid IsVisible="{Binding IsPdf}">
                <Border
                  Width="82"
                  Height="96"
                  Background="#FFF5F5"
                  BorderBrush="#F0A0A8"
                  BorderThickness="1.5"
                  CornerRadius="12" />
                <Border
                  Width="82"
                  Height="24"
                  VerticalAlignment="Bottom"
                  Background="#EF4444"
                  CornerRadius="0,0,12,12" />
                <TextBlock
                  Margin="0,0,0,6"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  FontSize="9"
                  FontWeight="SemiBold"
                  Foreground="White"
                  Text="PDF" />
              </Grid>
              <Grid IsVisible="{Binding IsWord}">
                <Border
                  Width="82"
                  Height="96"
                  Background="#EFF6FF"
                  BorderBrush="#93C5FD"
                  BorderThickness="1.5"
                  CornerRadius="12" />
                <Border
                  Width="82"
                  Height="24"
                  VerticalAlignment="Bottom"
                  Background="#2563EB"
                  CornerRadius="0,0,12,12" />
                <TextBlock
                  Margin="0,0,0,6"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  FontSize="9"
                  FontWeight="SemiBold"
                  Foreground="White"
                  Text="DOC" />
              </Grid>
              <Grid IsVisible="{Binding IsExcel}">
                <Border
                  Width="82"
                  Height="96"
                  Background="#F0FDF4"
                  BorderBrush="#86EFAC"
                  BorderThickness="1.5"
                  CornerRadius="12" />
                <Border
                  Width="82"
                  Height="24"
                  VerticalAlignment="Bottom"
                  Background="#16A34A"
                  CornerRadius="0,0,12,12" />
                <TextBlock
                  Margin="0,0,0,6"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  FontSize="9"
                  FontWeight="SemiBold"
                  Foreground="White"
                  Text="XLS" />
