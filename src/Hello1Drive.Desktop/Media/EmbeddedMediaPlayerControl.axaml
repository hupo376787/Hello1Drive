<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
             x:Class="Hello1Drive.Desktop.Media.EmbeddedMediaPlayerControl"
             Background="#E6000000"
             Focusable="True">
  <Grid RowDefinitions="*,Auto">
    <Border Grid.Row="0" Background="Black" ClipToBounds="True">
      <vlc:VideoView x:Name="VideoPlayer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    </Border>

    <Border Grid.Row="1" Background="#E8191919" Padding="10,7">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,100" ColumnSpacing="8">
        <Button x:Name="PlayPauseButton" Grid.Column="0" Width="34" Height="30" Padding="0"
                Content="⏸" Foreground="#FF8F91" Background="#22FD6F71"
                Click="PlayPauseButton_Click" ToolTip.Tip="播放 / 暂停" />
        <TextBlock x:Name="CurrentTimeText" Grid.Column="1" Text="00:00" VerticalAlignment="Center" Foreground="White" MinWidth="44" />
        <Slider x:Name="PositionSlider" Grid.Column="2" Minimum="0" Maximum="1" Value="0"
                IsEnabled="False"
                VerticalAlignment="Center"
                ValueChanged="PositionSlider_ValueChanged" />
        <TextBlock x:Name="DurationText" Grid.Column="3" Text="00:00" VerticalAlignment="Center" Foreground="White" MinWidth="44" />
        <Button x:Name="MuteButton" Grid.Column="4" Width="34" Height="30" Padding="0"
                Content="🔊" Foreground="#53D7E8" Background="#2053D7E8"
                Click="MuteButton_Click" ToolTip.Tip="静音" />
        <Slider x:Name="VolumeSlider" Grid.Column="5" Minimum="0" Maximum="100" Value="80"
                VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
      </Grid>
    </Border>

    <Border x:Name="ErrorOverlay" Grid.RowSpan="2" Background="#D9000000" IsVisible="False">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="520">
        <TextBlock Text="无法播放此媒体" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock x:Name="ErrorText" Foreground="#D8FFFFFF" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
